---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import MoroccoMap from '@/components/MoroccoMap.astro';
import CtaBand from '@/components/CtaBand.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import { getRegions, getServices, regionPath, servicePath, pad, paragraphs, type Region } from '@/lib/content';
import { breadcrumb, service as serviceLd } from '@/lib/schema';

export async function getStaticPaths() {
  const regions = await getRegions();
  return regions.map((r) => ({ params: { region: r.id }, props: { entry: r } }));
}
const { entry } = Astro.props as { entry: Region };
const d = entry.data;
const base = Astro.site!;
const path = regionPath(entry.id);
const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Aménagement de cabinet médical', path: '/amenagement-cabinet-medical/' },
  { name: d.name, path },
];
const services = (await getServices()).filter((s) => ['etude-faisabilite-programmation-medicale', 'conception-amenagement-cabinet-medical', 'travaux-amenagement-cabinet-clinique', 'renovation-cabinet-clinique-site-occupe'].includes(s.id));
const regions = await getRegions();
const inRegion = entry.id === 'oriental' ? 'dans l’Oriental' : `dans la région ${d.name}`;
const others = regions.filter((r) => r.id !== entry.id).slice(0, 4);
---
<BaseLayout
  title={d.title}
  description={d.description}
  context={`Région ${d.name}`}
  jsonld={[breadcrumb(base, crumbs), { ...serviceLd(base, { name: d.h1, description: d.description, path }), areaServed: d.villes.map((v) => ({ '@type': 'City', name: v })) }]}
>
  <PageHero eyebrow={`Région · ${d.name}`} h1={d.h1} intro={d.description} crumbs={crumbs} ctaLabel="Demander une visite technique" />

  <section class="py-20 lg:py-28">
    <div class="container-lux grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <div class="mb-14 space-y-4 text-[1.06rem] leading-relaxed text-[var(--color-ink)]">
          {paragraphs(d.intro).map((t) => <p>{t}</p>)}
        </div>
        <p class="eyebrow text-[var(--color-teal-ink)]">Contexte</p>
        <h2 class="mt-6">Le besoin en structures de soins dans la région</h2>
        <p class="mt-8 text-[1.06rem] leading-relaxed text-[var(--color-muted)]">{d.contexte}</p>
        <h3 class="mt-12">Projets que nous accompagnons</h3>
        <ul class="mt-6 space-y-4">
          {d.priorites.map((p) => <li class="flex gap-4 border-b border-[var(--color-line)] pb-4"><span class="mt-3 block h-px w-6 shrink-0 bg-[var(--color-teal-ink)]"></span>{p}</li>)}
        </ul>
        <h3 class="mt-12">Villes desservies</h3>
        <p class="mt-4 text-[var(--color-muted)]">{d.villes.join(' · ')}, et l’ensemble des communes de la région.</p>
      </div>
      <aside class="lg:col-span-5">
        <div class="sticky top-32 bg-[var(--color-navy)] p-8">
          <MoroccoMap class="w-full" />
          <p class="caption mt-4 text-center text-[var(--color-warm)]/60">Carte schématique</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[var(--color-mist)] py-20 lg:py-28">
    <div class="container-lux grid gap-16 lg:grid-cols-2">
      <RelatedLinks title={`Nos services ${inRegion}`} links={services.map((s) => ({ href: servicePath(s.id), label: s.data.short, meta: `Service ${pad(s.data.order)}` }))} />
      <RelatedLinks title="Autres régions" links={others.map((r) => ({ href: regionPath(r.id), label: r.data.name, meta: 'Région' })).concat([{ href: '/zones-intervention/', label: 'Toutes les zones d’intervention', meta: 'Maroc' }])} />
    </div>
  </section>

  <CtaBand context={`Région ${d.name}`} title={`Un projet ${inRegion} ?`} />
</BaseLayout>

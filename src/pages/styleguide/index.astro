---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/Logo.astro';
import Photo from '@/components/Photo.astro';
import PlanArt from '@/components/PlanArt.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import SpecialtyCard from '@/components/SpecialtyCard.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import BeforeAfter from '@/components/BeforeAfter.astro';
import Lightbox from '@/components/Lightbox.astro';
import Faq from '@/components/Faq.astro';

const colors = [
  ['Deep Navy', '#142C43', '20 % · titres, navigation, boutons, footer'],
  ['Medical Teal', '#168C91', '4 % · accents, états actifs, filets'],
  ['Teal texte', '#0F6E72', 'petits textes et liens en teal (AA)'],
  ['Champagne Gold', '#C6A66B', '1 % · détails premium uniquement'],
  ['Warm White', '#F7F8F7', '65 % · fond principal (avec le blanc)'],
  ['Soft Grey', '#E9EEF0', '10 % · fond alterné'],
  ['Primary Text', '#263746', 'texte courant'],
  ['Secondary Text', '#697782', 'grands textes secondaires, icônes'],
  ['Secondary Text AA', '#5E6C77', 'petits textes secondaires'],
];
const files = ['esm-logo-horizontal', 'esm-logo-horizontal-navy', 'esm-logo-horizontal-white', 'esm-logo-horizontal-mono', 'esm-logo-vertical', 'esm-logo-vertical-white', 'esm-logo-vertical-mono', 'esm-symbol', 'esm-symbol-navy', 'esm-symbol-white', 'esm-symbol-mono'];
---
<BaseLayout title="Styleguide interne" description="Page interne de validation de l’identité Euro Space Medical : logos, couleurs, typographie, composants et animations, non indexée par les moteurs de recherche." noindex context="Styleguide">
  <section class="border-b border-[var(--color-line)] py-16">
    <div class="container-lux">
      <p class="eyebrow text-[var(--color-teal-ink)]">Identité</p>
      <h1 class="mt-5">Euro Space Medical — styleguide</h1>
      <p class="mt-4 max-w-2xl text-[var(--color-muted)]"><span lang="en">Designing medical spaces.</span> · Votre projet médical, de A à Z.</p>
    </div>
  </section>

  <section class="container-lux py-16">
    <h2>Logo</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="flex min-h-40 items-center justify-center border border-[var(--color-line)] bg-white p-8"><Logo /></div>
      <div class="flex min-h-40 items-center justify-center bg-[var(--color-navy)] p-8"><Logo tone="white" /></div>
      <div class="flex min-h-40 items-center justify-center border border-[var(--color-line)] bg-white p-8"><Logo layout="vertical" size={72} /></div>
      <div class="flex min-h-40 items-center justify-center gap-10 border border-[var(--color-line)] bg-white p-8">
        <Logo layout="symbol" size={64} /><Logo layout="symbol" tone="navy" size={64} />
        <span class="text-black"><Logo layout="symbol" tone="mono" size={64} /></span>
      </div>
    </div>
    <p class="mt-6 text-[0.95rem] text-[var(--color-muted)]">Fichiers vectoriels (texte vectorisé) : {files.map((f, i) => <>{i > 0 && ' · '}<a class="underline" href={`/brand/${f}.svg`}>{f}.svg</a></>)}</p>
    <p class="mt-2 text-[0.95rem] text-[var(--color-muted)]">Concept : cadre-plan ouvert (l’entrée du bâtiment), monogramme géométrique E·S·M, ligne de cote (précision d’ingénierie). Zone de protection : la hauteur du E autour du logo. Taille minimale : 24 px pour le symbole.</p>
  </section>

  <section class="bg-white py-16">
    <div class="container-lux">
      <h2>Couleurs</h2>
      <ul class="mt-10 grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-5">
        {colors.map(([n, hex, use]) => (
          <li><span class="block aspect-[4/3] border border-[var(--color-line)]" style={`background:${hex}`}></span><p class="mt-3 text-[0.9rem] font-semibold">{n} · {hex}</p><p class="text-[0.85rem] text-[var(--color-muted)]">{use}</p></li>
        ))}
      </ul>
      <h2 class="mt-20">Typographie</h2>
      <div class="mt-8 space-y-5">
        <p class="font-[family-name:var(--font-display)] text-[4rem] font-bold leading-none tracking-[-0.035em] text-[var(--color-navy)]">Manrope · héros 56–72 px</p>
        <p class="font-[family-name:var(--font-display)] text-[2.5rem] font-semibold tracking-[-0.025em] text-[var(--color-navy)]">Manrope · titres de section 36–44 px</p>
        <p class="font-[family-name:var(--font-display)] text-[1.375rem] font-semibold text-[var(--color-navy)]">Manrope · titres de carte 21–24 px</p>
        <p class="text-[1.06rem]">Inter · texte courant 16–18 px. Phrases courtes, vouvoiement, apostrophes typographiques.</p>
        <p class="eyebrow text-[var(--color-teal-ink)]">Libellé · 12–13 px</p>
      </div>
      <h2 class="mt-20">Boutons et liens</h2>
      <div class="mt-8 flex flex-wrap items-center gap-4"><a href="#" class="btn btn-primary">Parler de mon projet <span class="arrow">→</span></a><a href="#" class="btn btn-ghost-dark">Secondaire</a><a href="#" class="link-more">Découvrir <span>→</span></a></div>
      <div class="mt-4 flex flex-wrap gap-4 bg-[var(--color-navy)] p-6"><a href="#" class="btn btn-primary">Principal sur navy</a><a href="#" class="btn btn-ghost-light">Secondaire sur navy</a></div>
    </div>
  </section>

  <section class="container-lux py-16">
    <h2>Composants</h2>
    <div class="mt-10 grid gap-10 md:grid-cols-3">
      <ServiceCard id="conception-amenagement-cabinet-medical" order={2} short="Conception 2D et 3D" h1="" intro="" description="Plans 2D, rendus 3D et dossier technique." termes={['Marche en avant', 'Rendus 3D']} />
      <SpecialtyCard id="cabinet-dentaire-orthodontie" short="Dentaire et orthodontie" contrainte="Travail à quatre mains, réseaux dédiés." />
      <div><div class="aspect-[4/3] overflow-hidden"><Photo name="hallClinique" sizes="33vw" widths={[480, 800]} class="h-full w-full object-cover" /></div><p class="mt-3 text-[0.85rem] text-[var(--color-muted)]">Photo d’illustration (Unsplash), AVIF/WebP</p></div>
    </div>
    <h3 class="mt-16">Processus</h3>
    <div class="mt-8"><ProcessSteps /></div>
    <h3 class="mt-16">Comparateur avant/après (souris, doigt, clavier)</h3>
    <div class="mt-8">
      <BeforeAfter>
        <div slot="before" class="h-full w-full grayscale"><PlanArt variant="default" tone="light" class="h-full w-full" circuit={false} label="Avant (illustration)" /></div>
        <div slot="after" class="h-full w-full"><PlanArt variant="cabinet-dentaire-orthodontie" tone="light" class="h-full w-full" label="Après (illustration)" /></div>
      </BeforeAfter>
    </div>
    <h3 class="mt-16">Visionneuse</h3>
    <ul class="mt-8 grid grid-cols-3 gap-4">
      {['default', 'amenagement', 'renovation'].map((n, i) => (
        <li><a href={`/og/${n}.png`} data-lightbox="sg" data-caption={`Image de partage ${i + 1}`}><img src={`/og/${n}.png`} alt={`Image de partage ${n}`} width="1200" height="630" loading="lazy" class="w-full" /></a></li>
      ))}
    </ul>
    <h3 class="mt-16">Mouvement</h3>
    <p class="mt-4 max-w-2xl text-[var(--color-muted)]">200–400 ms, courbe sobre. Révélations courtes au défilement, léger zoom (1,03) au survol des cartes, transitions de page natives. Aucun effet continu, aucune parallaxe. Avec <code>prefers-reduced-motion</code>, tout est désactivé.</p>
  </section>
  <Faq items={[{ q: 'Exemple de question ?', a: 'Exemple de réponse dans un élément details.' }]} title="FAQ (details)" tone="sand" />
  <Lightbox />
</BaseLayout>

---
/**
 * Gabarit de page service :
 * 1. fil d'Ariane · 2. libellé · 3. H1 · 4. introduction courte · 5. visuel (PageHero)
 * 6. L'essentiel en 3 cartes · 7. approche + schéma · 8. livrables en étapes numérotées · 9. appel à l'action intercalé
 * 10. explications techniques en accordéon (secondaire) · 11. questions fréquentes · 12. liens associés · 13. CTA final
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PlanArt from '@/components/PlanArt.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import { getServices, getSpecialites, getPosts, servicePath, specialitePath, postPath, pad, paragraphs, type Service } from '@/lib/content';
import { serviceVisual } from '@/lib/photos';
import { glossaireGeneral } from '@/data/glossaire';
import { breadcrumb, faqPage, service as serviceLd } from '@/lib/schema';
import { whatsappLink } from '@/config/site';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((s) => ({ params: { slug: s.id }, props: { entry: s } }));
}
const { entry } = Astro.props as { entry: Service };
const d = entry.data;
const base = Astro.site!;
const path = servicePath(entry.id);
const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Services', path: '/services/' }, { name: d.short, path }];

const allServices = await getServices();
const specialites = await getSpecialites();
const linkedSpecs = specialites.filter((s) => d.specialitesLiees.includes(s.id) || s.data.servicesLies.includes(entry.id));
const related = Array.from({ length: 4 }, (_, k) => allServices[(d.order + k) % allServices.length]!);
const guides = (await getPosts()).filter((g) => g.data.servicesLies.includes(entry.id)).slice(0, 3);
const wa = whatsappLink(`Bonjour, je suis intéressé(e) par votre service « ${d.short} ».`);
const visual = serviceVisual[entry.id]!;
const diagramVariant = 'photo' in visual ? (d.specialitesLiees[0] ?? 'default') : null;

// Explications techniques : définitions du glossaire et des lexiques correspondant aux termes du service
const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const dictionary = [...glossaireGeneral.flatMap((g) => g.termes), ...specialites.flatMap((s) => s.data.lexique)];
const explanations = d.termes
  .map((t) => {
    const key = norm(t).split(/[ (]/)[0]!;
    const hit = dictionary.find((x) => norm(x.terme).startsWith(norm(t)) || norm(t).startsWith(norm(x.terme)) || (key.length > 3 && norm(x.terme).startsWith(key)));
    return hit ? { q: hit.terme, a: hit.definition } : null;
  })
  .filter((x): x is { q: string; a: string } => x !== null)
  .filter((x, i, arr) => arr.findIndex((y) => y.q === x.q) === i);
---
<BaseLayout
  title={d.title}
  description={d.description}
  context={d.short}
  jsonld={[breadcrumb(base, crumbs), serviceLd(base, { name: d.h1, description: d.description, path, type: d.short }), ...(d.faq.length ? [faqPage(d.faq)] : [])]}
>
  <PageHero eyebrow={`Service ${pad(d.order)}`} h1={d.h1} intro={d.description} crumbs={crumbs} visual={visual} ctaLabel={d.cta} />

  <!-- L'ESSENTIEL -->
  {d.savoirFaire.length > 0 && (
    <section class="bg-white py-20 lg:py-24" aria-labelledby="essentiel-title">
      <div class="container-lux">
        <SectionHeading eyebrow="L’essentiel" title="Notre savoir-faire technique" id="essentiel-title" />
        <ul class="mt-12 grid gap-6 md:grid-cols-3">
          {d.savoirFaire.map((x, i) => (
            <li class="flex flex-col border border-[var(--color-line)] bg-[var(--color-warm)] p-7 lg:p-8" data-reveal style={`--i:${i}`}>
              <span class="num text-[0.95rem]">{pad(i + 1)}</span>
              <h3 class="mt-3 text-[1.25rem]">{x.t}</h3>
              <p class="mt-3 text-[0.98rem] leading-relaxed text-[var(--color-muted)]">{x.p}</p>
            </li>
          ))}
        </ul>
        {d.termes.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2" aria-label="Termes techniques maîtrisés">
            {d.termes.map((t) => <li class="border border-[var(--color-line)] px-3 py-1.5 text-[0.85rem] font-medium text-[var(--color-ink)]">{t}</li>)}
          </ul>
        )}
      </div>
    </section>
  )}

  <!-- APPROCHE -->
  <section class="py-20 lg:py-28" aria-labelledby="approche-title">
    <div class="container-lux grid items-start gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6" data-reveal>
        <p class="eyebrow text-[var(--color-teal-ink)]">Notre approche</p>
        <h2 id="approche-title" class="mt-5">Comment nous travaillons</h2>
        <div class="mt-8 space-y-4 text-[1.06rem] leading-relaxed">
          {paragraphs(d.intro).map((t) => <p>{t}</p>)}
        </div>
        {d.note && <p class="mt-8 border-l-2 border-[var(--color-gold)] pl-5 text-[0.95rem] text-[var(--color-muted)]">{d.note}</p>}
      </div>
      <div class="lg:col-span-6" data-reveal style="--i:1">
        {diagramVariant ? (
          <figure>
            <div class="aspect-[4/3] overflow-hidden rounded-[var(--radius-photo)] bg-[var(--color-mist)]">
              <PlanArt variant={diagramVariant} tone="light" class="h-full w-full" label={`Schéma de principe — ${d.short}`} />
            </div>
            <figcaption class="mt-2.5 text-[0.78rem] text-[var(--color-muted)]">Schéma de principe · illustration non contractuelle</figcaption>
          </figure>
        ) : (
          <div class="border border-[var(--color-line)] bg-white p-8 lg:p-10">
            <p class="eyebrow text-[var(--color-teal-ink)]">Votre projet</p>
            <p class="mt-4 font-[family-name:var(--font-display)] text-[1.5rem] font-semibold leading-snug text-[var(--color-navy)]">{d.cta}</p>
            <p class="mt-3 text-[0.98rem] text-[var(--color-muted)]">Décrivez votre structure et votre calendrier : nous revenons vers vous avec une première approche.</p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href="/contact/" class="btn btn-primary">Parler de mon projet</a>
              {wa && <a href={wa} target="_blank" rel="noopener" class="btn btn-ghost-dark">WhatsApp</a>}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- LIVRABLES -->
  <section class="bg-white py-20 lg:py-28" aria-labelledby="livrables-title">
    <div class="container-lux">
      <SectionHeading eyebrow="Livrables" title="Ce que vous recevez" id="livrables-title" />
      <ol class="mt-12 grid gap-px overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)] sm:grid-cols-2 lg:grid-cols-3">
        {d.livrables.map((l, i) => (
          <li class="bg-white p-7" data-reveal style={`--i:${i % 3}`}>
            <span class="num text-[1.5rem]">{pad(i + 1)}</span>
            <p class="mt-3 text-[1.02rem] leading-relaxed">{l}</p>
          </li>
        ))}
        {d.livrables.length % 3 !== 0 && (
          <li class="hidden bg-[var(--color-navy)] p-7 text-white lg:flex lg:flex-col lg:justify-between">
            <p class="font-[family-name:var(--font-display)] text-[1.25rem] font-semibold leading-snug">{d.cta}</p>
            <a href="/contact/" class="link-more mt-6">Parler de mon projet <span>→</span></a>
          </li>
        )}
      </ol>
    </div>
  </section>

  <!-- EXPLICATIONS TECHNIQUES (secondaire, en accordéon) -->
  {explanations.length > 0 && <Faq items={explanations} title="Termes techniques expliqués" eyebrow="Pour aller plus loin" tone="sand" />}

  <Faq items={d.faq} title="Questions fréquentes" />

  <!-- LIENS ASSOCIÉS -->
  <section class="border-t border-[var(--color-line)] py-20 lg:py-24">
    <div class="container-lux grid gap-14 lg:grid-cols-3">
      <RelatedLinks title="Spécialités concernées" links={linkedSpecs.slice(0, 4).map((s) => ({ href: specialitePath(s.id), label: s.data.short, meta: 'Spécialité' }))} />
      <RelatedLinks title="Services associés" links={related.map((s) => ({ href: servicePath(s.id), label: s.data.short, meta: `Service ${pad(s.data.order)}` }))} />
      {guides.length > 0 && <RelatedLinks title="Guides pratiques" links={guides.map((g) => ({ href: postPath(g.id), label: g.data.h1, meta: 'Guide' }))} />}
    </div>
  </section>

  <CtaBand context={d.short} title={d.cta} />
</BaseLayout>

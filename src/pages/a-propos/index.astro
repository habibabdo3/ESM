---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Todo from '@/components/Todo.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/config/site';
import { breadcrumb } from '@/lib/schema';

const base = Astro.site!;
const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'À propos', path: '/a-propos/' }];
const piliers = [
  { t: 'Un interlocuteur unique', p: 'Du programme à la réception, un seul responsable coordonne la conception, les travaux, l’équipement et le financement.' },
  { t: 'La spécialité d’abord', p: 'Le plan part de l’acte médical, pas du mètre carré. Chaque discipline a ses contraintes : nous les intégrons dès la première esquisse.' },
  { t: 'Zéro surprise', p: 'Budget par lot, planning détaillé, comptes rendus hebdomadaires, essais et procès-verbal de réception.' },
];
---
<BaseLayout
  title="À propos d’Euro Space Medical"
  description="Euro Space Medical conçoit, rénove et équipe les structures médicales au Maroc : une équipe, une méthode et des engagements au service des praticiens."
  jsonld={[breadcrumb(base, crumbs)]}
  context="À propos"
>
  <PageHero eyebrow="À propos" h1="Concevoir des lieux de soin qui fonctionnent" intro={site.promise} crumbs={crumbs} photo="salleIntervention" />
  <section class="py-20 lg:py-28">
    <div class="container-lux grid gap-12 md:grid-cols-3">
      {piliers.map((p, i) => (
        <div data-reveal style={`--i:${i}`}><span class="num text-5xl">0{i + 1}</span><h2 class="mt-6 text-[2rem]">{p.t}</h2><p class="mt-4 text-[var(--color-muted)]">{p.p}</p></div>
      ))}
    </div>
  </section>
  <section class="bg-[var(--color-mist)] py-20 lg:py-28">
    <div class="container-lux grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4"><p class="eyebrow text-[var(--color-teal-ink)]">Équipe</p><h2 class="mt-6">Les personnes derrière vos projets</h2></div>
      <div class="space-y-6 lg:col-span-8">
        <p class="text-[var(--color-muted)]">Architectes, ingénieurs, conducteurs de travaux : présentez ici l’équipe nommée, ses qualifications et ses partenaires techniques (physicien pour la radioprotection, bureau de contrôle, prestataire de déchets médicaux).</p>
        <p><Todo label="équipe nommée, qualifications, photos" /></p>
        <p><Todo label="assurances (responsabilité civile professionnelle, garantie des ouvrages)" /></p>
        <p><Todo label="partenaires techniques et fabricants" /></p>
      </div>
    </div>
  </section>
  <CtaBand context="À propos" />
</BaseLayout>

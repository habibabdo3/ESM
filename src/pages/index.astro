---
/**
 * Accueil immersif : un seul parcours continu.
 * 1. #journey — maquette 3D épinglée : plan coté → réseaux → murs → coupe équipée → réception. Au départ, la maquette
 *    est une planche encadrée à côté du titre ; elle s'étire en plein écran au premier défilement. Légende compacte
 *    + sommaire des étapes ensuite. Le parcours tient lieu de méthode.
 * 2. Expertises — quatre bandes d'images jointives : la bande active s'élargit (défilement épinglé ou survol, desktop).
 * 3. Pourquoi ESM — comparatif « Plusieurs prestataires / Avec ESM ».
 * 4. Bandeau des spécialités, puis les spécialités dessinées comme le plan d'un centre médical (SpecPlan).
 * 5. Réalisations — tant qu'aucune étude de cas n'est publiée : projets types en cartes qui s'empilent.
 * Sans WebGL, appareil peu puissant ou « réduire les animations » : même contenu, en défilement classique.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Visual from '@/components/Visual.astro';
import PlanArt from '@/components/PlanArt.astro';
import SpecPlan from '@/components/SpecPlan.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaBand from '@/components/CtaBand.astro';
import RealisationCard from '@/components/RealisationCard.astro';
import { site, BANK_DISCLAIMER } from '@/config/site';
import { getRealisations, getServices, getSpecialites, servicePath, specialitePath } from '@/lib/content';
import { expertises, specialiteVisual } from '@/lib/photos';

const realisations = await getRealisations();
const specialites = await getSpecialites();
const services = await getServices();
const serviceName = new Map(services.map((s) => [s.id, s.data.short]));
const chapters = [
  { at: 0.1, num: '01', title: 'Concevoir', text: 'Plan coté, circuits patients séparés, emprise de chaque équipement.', href: '/expertises/#etude-conception' },
  { at: 0.28, num: '02', title: 'Construire', text: 'Réseaux encastrés, cloisons et menuiseries, contrôlés lot par lot.', href: '/expertises/#construction-renovation' },
  { at: 0.5, num: '03', title: 'Équiper', text: 'Fauteuils, stérilisation, compresseur : tout est prévu dès les plans.', href: '/expertises/#equipement-medical' },
  { at: 0.78, num: '04', title: 'Livrer', text: 'Réception pièce par pièce, procès-verbal et dossier des ouvrages.', href: '/expertises/#accompagnement-global' },
];
const compare = [
  { t: 'Interlocuteurs', without: 'Architecte, entreprises, fournisseurs et banque : un contact par métier.', with: 'Un interlocuteur unique, de la première esquisse à l’ouverture.' },
  { t: 'Plans', without: 'Un plan générique, adapté ensuite à l’activité.', with: 'Le plan part de l’acte médical et des règles de votre spécialité.' },
  { t: 'Équipements', without: 'Choisis après les travaux, réseaux à reprendre.', with: 'Prévus dès les plans : fluides et électricité dimensionnés.' },
  { t: 'Budget', without: 'Des devis séparés, des écarts découverts en chantier.', with: 'Un budget par lot, validé avant le démarrage des travaux.' },
  { t: 'Rénovation', without: 'Le cabinet ferme pendant toute la durée des travaux.', with: 'Des travaux phasés en site occupé quand votre activité le permet.' },
  { t: 'Financement', without: 'Un dossier bancaire à monter seul.', with: 'Un dossier préparé et suivi avec nos banques partenaires.*' },
];
const projectIds = ['cabinet-dentaire-orthodontie', 'radiologie-imagerie-medicale', 'cliniques-blocs-operatoires', 'laboratoire-analyses-medicales'];
const projects = projectIds.map((id) => specialites.find((s) => s.id === id)).filter((s) => s !== undefined);
---

<BaseLayout
  title={site.name}
  description="Conception, construction, rénovation et équipement de cabinets, cliniques, centres d’imagerie et laboratoires, partout au Maroc, de l’étude à la livraison."
  context="Accueil"
>
  <!-- 1. PARCOURS 3D -->
  <section id="journey" class="journey relative bg-[var(--color-warm)]" aria-label="Du plan à la structure livrée">
    <div class="journey-stage">
      <div class="journey-frame" data-journey-frame aria-hidden="true">
        <div class="journey-fallback">
          <PlanArt variant="cabinet-dentaire-orthodontie" tone="light" class="h-full w-full" label="" />
        </div>
        <canvas class="journey-canvas"></canvas>
        <div class="journey-cartouche">
          <span>Plan type</span>
          <strong>Cabinet dentaire</strong>
          <span>Illustration ESM</span>
        </div>
      </div>

      <div class="container-lux journey-copy">
        <div data-chapter="0" class="journey-chapter journey-hero is-active">
          <p class="journey-kicker"><span lang="en">Designing medical spaces.</span><i aria-hidden="true"></i><span>Partout au Maroc</span></p>
          <h1 class="journey-title">
            <span class="ln"><span>Des espaces </span></span><span class="ln"><span>conçus pour </span></span><span class="ln"><span>mieux <em>soigner.</em></span></span>
          </h1>
          <div class="journey-lede">
            <p>De la conception architecturale à l’équipement, nous accompagnons vos projets médicaux de A à Z.</p>
            <div class="journey-actions">
              <a href="/contact/" class="btn btn-primary">Démarrer mon projet <span class="arrow" aria-hidden="true">→</span></a>
              <a href="/expertises/" class="link-more">Nos expertises <span>→</span></a>
            </div>
          </div>
          <p class="journey-scroll" aria-hidden="true"><i></i>Faites défiler : le plan devient un cabinet</p>
        </div>

        {chapters.map((c) => (
          <div data-chapter={c.at} class="journey-chapter journey-caption">
            <p class="journey-caption-num"><span>{c.num}</span> / 04</p>
            <h2 class="journey-caption-title">{c.title}</h2>
            <p class="journey-caption-text">{c.text}</p>
            <a href={c.href} class="link-more mt-4">En savoir plus <span>→</span></a>
          </div>
        ))}
      </div>

      <nav class="journey-nav" aria-label="Étapes du parcours">
        <ol>
          {chapters.map((c) => (
            <li><button type="button" data-goto={c.at}><span class="journey-nav-num">{c.num}</span><span class="journey-nav-label">{c.title}</span></button></li>
          ))}
        </ol>
      </nav>
      <div class="journey-progress" aria-hidden="true"><span data-journey-bar></span></div>
    </div>
  </section>

  <!-- 2. EXPERTISES : bandes d'images jointives qui s'élargissent -->
  <section data-strips class="strips bg-[var(--color-navy)] text-white" aria-labelledby="expertises-title">
    <div class="strips-inner">
      <div class="container-lux strips-head">
        <div>
          <p class="eyebrow text-[var(--color-gold)]">Expertises</p>
          <h2 id="expertises-title" class="mt-5 text-white">Quatre expertises, un seul partenaire.</h2>
        </div>
        <a href="/expertises/" class="link-more text-white">Toutes nos expertises <span>→</span></a>
      </div>
      <ul class="strips-row" aria-label="Nos quatre expertises">
        {expertises.map((e, i) => (
          <li class:list={['strip', i === 0 && 'is-open']} data-strip>
            <div class="strip-media" aria-hidden="true">
              <Visual visual={e.visual} sizes="(min-width:1024px) 60vw, 100vw" widths={[640, 1000, 1400]} />
            </div>
            <div class="strip-shade" aria-hidden="true"></div>
            <p class="strip-tab" aria-hidden="true"><span>{e.num}</span>{e.title}</p>
            <div class="strip-body">
              <span class="strip-num" aria-hidden="true">{e.num}</span>
              <h3 class="strip-title"><a href={`/expertises/#${e.id}`}>{e.title}</a></h3>
              <p class="strip-text">{e.text}</p>
              <ul class="strip-services" aria-label={`Services : ${e.title}`}>
                {e.services.map((id) => (
                  <li><a href={servicePath(id)}><span>{serviceName.get(id) ?? id}</span><span aria-hidden="true">→</span></a></li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. POURQUOI ESM : comparatif -->
  <section class="bg-white py-24 lg:py-32" aria-labelledby="why-title">
    <div class="container-lux grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <p class="eyebrow text-[var(--color-teal-ink)]">Pourquoi ESM</p>
          <h2 id="why-title" class="mt-6">Un seul interlocuteur change tout.</h2>
          <p class="mt-5 max-w-sm text-[1.05rem] leading-relaxed text-[var(--color-muted)]">Le regard d’un architecte, la rigueur d’un ingénieur, et une équipe qui tient le fil du premier plan à l’ouverture.</p>
          <a href="/contact/" class="btn btn-primary mt-8">Parler de mon projet <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="lg:col-span-8">
        <table class="compare">
          <caption class="sr-only">Un projet médical mené avec plusieurs prestataires, ou avec Euro Space Medical</caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Sujet</span></th>
              <th scope="col">Plusieurs prestataires</th>
              <th scope="col" class="compare-esm">Avec ESM</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((r, i) => (
              <tr data-reveal style={`--i:${i % 3}`}>
                <th scope="row">{r.t}</th>
                <td class="compare-without" data-label="Plusieurs prestataires">{r.without}</td>
                <td class="compare-with" data-label="Avec ESM">{r.with}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-5 text-[0.85rem] text-[var(--color-muted)]">* Al Barid Bank et Bank Al Yousr. {BANK_DISCLAIMER}</p>
      </div>
    </div>
  </section>

  <!-- Bandeau défilant (décoratif) -->
  <div class="marquee bg-[var(--color-warm)]" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <span class="marquee-group">
          {specialites.map((s) => <span class="marquee-item">{s.data.short}<i></i></span>)}
        </span>
      ))}
    </div>
  </div>

  <!-- 4. SPÉCIALITÉS : le plan d'un centre médical -->
  <section class="bg-[var(--color-warm)] pb-24 pt-20 lg:pb-32 lg:pt-28" aria-labelledby="spec-title">
    <div class="container-lux">
      <SectionHeading eyebrow="Spécialités" title="Chaque spécialité a ses règles." id="spec-title" intro="Quatorze disciplines, chacune avec son plan type, ses réseaux et ses autorisations. Ouvrez une pièce." link={{ href: '/specialites/', label: 'Toutes les spécialités' }} />
      <div class="mt-12">
        <SpecPlan items={specialites.map((s) => ({ id: s.id, short: s.data.short, contrainte: s.data.contraintes[0] ?? '' }))} />
      </div>
    </div>
  </section>

  <!-- 5. RÉALISATIONS -->
  <section class="bg-white pt-24 lg:pt-32" aria-labelledby="real-title">
    <div class="container-lux">
      {realisations.length > 0 ? (
        <>
          <SectionHeading eyebrow="Réalisations" title="Des espaces pensés pour soigner." id="real-title" link={{ href: '/realisations/', label: 'Toutes les réalisations' }} />
          <div class="mt-14 grid gap-x-8 gap-y-14 pb-24 md:grid-cols-2 lg:grid-cols-3 lg:pb-32">
            {realisations.slice(0, 3).map((r, i) => <RealisationCard entry={r} i={i} />)}
          </div>
        </>
      ) : (
        <SectionHeading eyebrow="Réalisations" title="Les projets que nous menons." id="real-title" intro="Nos études de cas arrivent. En attendant, voici les projets types que nous concevons, construisons et équipons." />
      )}
    </div>
    {realisations.length === 0 && (
      <>
        <ol class="container-lux stack" aria-label="Projets types">
          {projects.map((s, i) => (
            <li class="stack-item" data-stack style={`--i:${i}`}>
              <article class="stack-card" aria-labelledby={`proj-${s.id}`}>
                <div class="stack-media" aria-hidden="true">
                  <Visual visual={specialiteVisual[s.id] ?? { drawing: s.id, label: 'Plan type' }} sizes="(min-width:1024px) 50vw, 100vw" widths={[640, 1000, 1400]} />
                </div>
                <div class="stack-body">
                  <p class="stack-kicker">Projet type <span>{String(i + 1).padStart(2, '0')}</span> / {String(projects.length).padStart(2, '0')}</p>
                  <h3 id={`proj-${s.id}`} class="stack-title"><a href={specialitePath(s.id)}>{s.data.short}</a></h3>
                  <ul class="stack-list">
                    {s.data.offre.slice(0, 4).map((o) => <li>{o}</li>)}
                  </ul>
                  <span class="link-more mt-8" aria-hidden="true">Voir la spécialité <span>→</span></span>
                </div>
              </article>
            </li>
          ))}
        </ol>
        <p class="container-lux pb-24 pt-4 text-[0.8rem] text-[var(--color-muted)] lg:pb-32">Images d’illustration et plans types : ils ne représentent pas des projets Euro Space Medical.</p>
      </>
    )}
  </section>

  <CtaBand context="Accueil" title="Construisons votre prochain espace médical." text="Vous avez un projet de cabinet, de clinique ou de centre médical ?" photo="cabinetDentaire3" />
</BaseLayout>

<script>
  import '@/scripts/motion-home';
</script>

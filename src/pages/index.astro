---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Photo from '@/components/Photo.astro';
import Visual from '@/components/Visual.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import CtaBand from '@/components/CtaBand.astro';
import RealisationCard from '@/components/RealisationCard.astro';
import { site } from '@/config/site';
import { getRealisations } from '@/lib/content';
import { expertises } from '@/lib/photos';

const realisations = await getRealisations();
const why = [
  { t: 'L’expertise médicale', d: 'Des espaces conçus autour des praticiens et de leurs contraintes de soin.' },
  { t: 'Un seul partenaire', d: 'Un interlocuteur unique, de la première esquisse à l’installation des équipements.' },
  { t: 'Une vision globale', d: 'Architecture, ingénierie, travaux et équipement réunis dans une même vision.' },
];
---

<BaseLayout
  title={site.name}
  description="Conception, construction, rénovation et équipement de cabinets, cliniques, centres d’imagerie et laboratoires, partout au Maroc, de l’étude à la livraison."
  context="Accueil"
>
  <!-- HÉROS : le texte sur fond warm, la photo à cheval sur la transition warm → blanc -->
  <section class="bg-[var(--color-warm)]">
    <div class="container-lux grid gap-8 pb-12 pt-12 lg:grid-cols-12 lg:items-end lg:gap-16 lg:pb-16 lg:pt-20">
      <div class="lg:col-span-7">
        <p lang="en" class="eyebrow fade-up text-[var(--color-teal-ink)]">Designing medical spaces.</p>
        <h1 class="mt-6 text-[clamp(2.5rem,1.3rem+4.4vw,4.5rem)] font-bold leading-[1.05] tracking-[-0.035em]">
          <span class="line-mask"><span style="--i:0">Des espaces conçus</span></span>
          <span class="line-mask"><span style="--i:1">pour mieux soigner.</span></span>
        </h1>
      </div>
      <div class="lg:col-span-5">
        <p class="fade-up text-[1.15rem] leading-relaxed text-[var(--color-muted)]" style="--i:2">
          De la conception architecturale à l’équipement, nous accompagnons vos projets médicaux de A à Z.
        </p>
        <div class="fade-up mt-8 flex flex-wrap gap-3" style="--i:3">
          <a href="/contact/" class="btn btn-primary">Démarrer mon projet <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/expertises/" class="btn btn-ghost-dark">Découvrir nos expertises</a>
        </div>
      </div>
    </div>
  </section>
  <div class="bg-[linear-gradient(to_bottom,var(--color-warm)_0,var(--color-warm)_50%,var(--color-white)_50%,var(--color-white)_100%)]">
    <figure class="container-lux">
      <div class="aspect-[4/3] overflow-hidden rounded-[var(--radius-photo)] bg-[var(--color-mist)] sm:aspect-[16/9] lg:aspect-[21/9]">
        <Photo name="hallClinique" eager sizes="(min-width:1280px) 1184px, 100vw" widths={[640, 960, 1280, 1600, 2000, 2400]} class="h-full w-full object-cover" />
      </div>
      <figcaption class="mt-3 text-[0.8rem] text-[var(--color-muted)]">Image d’illustration</figcaption>
    </figure>
  </div>

  <!-- EXPERTISES -->
  <section class="bg-white pb-24 pt-20 lg:pb-32 lg:pt-28" aria-labelledby="expertises-title">
    <div class="container-lux">
      <SectionHeading eyebrow="Expertises" title="Quatre expertises, un seul partenaire." id="expertises-title" link={{ href: '/expertises/', label: 'Toutes nos expertises' }} />
      <ul class="mt-14 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
        {expertises.map((e, i) => (
          <li class="card-lux group relative" data-reveal style={`--i:${i}`}>
            <div class="card-media aspect-[4/3] overflow-hidden rounded-[var(--radius-photo)] bg-[var(--color-mist)] sm:aspect-[4/5]">
              <Visual visual={e.visual} sizes="(min-width:1024px) 22vw, (min-width:640px) 45vw, 100vw" widths={[400, 600, 800]} />
            </div>
            <p class="num mt-6 text-[0.9rem]">{e.num}</p>
            <h3 class="mt-2 text-[1.375rem]">
              <a href={`/expertises/#${e.id}`} class="no-underline after:absolute after:inset-0">{e.title}</a>
            </h3>
            <p class="mt-2 text-[0.98rem] leading-relaxed text-[var(--color-muted)]">{e.text}</p>
            <span class="link-more mt-4" aria-hidden="true">Découvrir <span>→</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- MÉTHODE -->
  <section class="py-24 lg:py-32" aria-labelledby="process-title">
    <div class="container-lux">
      <SectionHeading eyebrow="Notre méthode" title="Un processus clair, du premier rendez-vous à l’ouverture." id="process-title" />
      <div class="mt-16"><ProcessSteps /></div>
    </div>
  </section>

  <!-- RÉALISATIONS -->
  <section class="bg-[var(--color-mist)] py-24 lg:py-32" aria-labelledby="real-title">
    <div class="container-lux">
      <SectionHeading eyebrow="Réalisations" title="Des espaces pensés pour soigner." id="real-title" link={realisations.length > 0 ? { href: '/realisations/', label: 'Toutes les réalisations' } : undefined} />
      {realisations.length > 0 ? (
        <div class="mt-14 grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
          {realisations.slice(0, 3).map((r, i) => <RealisationCard entry={r} i={i} />)}
        </div>
      ) : (
        <div class="mt-14 grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <figure class="lg:col-span-7" data-reveal>
            <div class="aspect-[16/10] overflow-hidden rounded-[var(--radius-photo)] bg-white">
              <Photo name="cabinetDentaire" sizes="(min-width:1024px) 55vw, 100vw" widths={[640, 960, 1280]} class="h-full w-full object-cover" />
            </div>
            <figcaption class="mt-3 text-[0.8rem] text-[var(--color-muted)]">Image d’illustration, ne représente pas un projet Euro Space Medical</figcaption>
          </figure>
          <div class="lg:col-span-5" data-reveal style="--i:1">
            <h3 class="text-[1.5rem]">Nos études de cas arrivent.</h3>
            <p class="mt-4 text-[1.02rem] leading-relaxed text-[var(--color-muted)]">Chaque projet sera présenté avec sa spécialité, sa ville et ses photos avant et après. En rendez-vous, nous vous présentons des projets comparables au vôtre.</p>
            <a href="/contact/" class="btn btn-primary mt-8">Parler de mon projet <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- POURQUOI ESM -->
  <section class="bg-white py-24 lg:py-32" aria-labelledby="why-title">
    <div class="container-lux">
      <SectionHeading eyebrow="Pourquoi ESM" title="Le regard d’un architecte, la rigueur d’un ingénieur." id="why-title" />
      <ul class="mt-14 grid gap-12 md:grid-cols-3 md:gap-10">
        {why.map((w, i) => (
          <li class="border-t-2 border-[var(--color-navy)] pt-7" data-reveal style={`--i:${i}`}>
            <h3 class="text-[1.375rem]">{w.t}</h3>
            <p class="mt-3 max-w-sm text-[1rem] leading-relaxed text-[var(--color-muted)]">{w.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    context="Accueil"
    title="Construisons votre prochain espace médical."
    text="Vous avez un projet de cabinet, de clinique ou de centre médical ?"
    photo="cabinetDentaire3"
  />
</BaseLayout>

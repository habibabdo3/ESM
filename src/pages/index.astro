---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Photo from '@/components/Photo.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import CtaBand from '@/components/CtaBand.astro';
import RealisationCard from '@/components/RealisationCard.astro';
import { site } from '@/config/site';
import { getRealisations } from '@/lib/content';
import { expertises } from '@/lib/photos';

const realisations = await getRealisations();
const why = [
  { t: 'Medical expertise', d: 'Des espaces conçus autour des praticiens et de leurs contraintes de soin.' },
  { t: 'One project partner', d: 'Un seul interlocuteur, de la première esquisse à l’installation des équipements.' },
  { t: 'Global vision', d: 'Architecture, ingénierie, travaux et équipement réunis dans une même vision.' },
];
---

<BaseLayout
  title={site.name}
  description="Conception, construction, rénovation et équipement de cabinets, cliniques, centres d’imagerie et laboratoires, partout au Maroc, de l’étude à la livraison."
  context="Accueil"
>
  <!-- HÉROS -->
  <section class="bg-[var(--color-warm)]">
    <div class="container-lux grid gap-10 pb-12 pt-14 lg:grid-cols-12 lg:items-end lg:gap-16 lg:pb-16 lg:pt-24">
      <div class="lg:col-span-7">
        <p class="eyebrow fade-up text-[var(--color-teal-ink)]">Votre projet médical, de A à Z.</p>
        <h1 lang="en" class="mt-6 text-[clamp(2.6rem,1.4rem+4.6vw,4.5rem)] font-bold leading-[1.04] tracking-[-0.035em] text-[var(--color-navy)]">
          <span class="line-mask"><span style="--i:0">Designing spaces</span></span>
          <span class="line-mask"><span style="--i:1">for better healthcare.</span></span>
        </h1>
      </div>
      <div class="lg:col-span-5">
        <p class="fade-up text-[1.15rem] leading-relaxed text-[var(--color-muted)]" style="--i:2">
          De l’étude à la réalisation, nous donnons vie à vos projets médicaux.
        </p>
        <div class="fade-up mt-8 flex flex-wrap gap-3" style="--i:3">
          <a href="/contact/" class="btn btn-primary">Démarrer mon projet <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/expertises/" class="btn btn-ghost-dark">Découvrir nos expertises</a>
        </div>
      </div>
    </div>
    <figure class="container-lux pb-20 lg:pb-28">
      <div class="aspect-[4/3] overflow-hidden rounded-[var(--radius-photo)] bg-[var(--color-mist)] sm:aspect-[16/9] lg:aspect-[21/9]">
        <Photo name="hallClinique" eager sizes="(min-width:1280px) 1184px, 100vw" widths={[640, 960, 1280, 1600, 2000, 2400]} class="h-full w-full object-cover" />
      </div>
      <figcaption class="mt-3 text-[0.8rem] text-[var(--color-muted)]">Image d’illustration</figcaption>
    </figure>
  </section>

  <!-- EXPERTISES -->
  <section class="bg-white py-24 lg:py-32" aria-labelledby="expertises-title">
    <div class="container-lux">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div data-reveal>
          <p class="eyebrow text-[var(--color-teal-ink)]">Expertises</p>
          <h2 id="expertises-title" class="mt-5 max-w-xl text-[var(--color-navy)]">Quatre expertises, un seul partenaire.</h2>
        </div>
        <a href="/expertises/" class="link-more self-start md:self-auto">Toutes nos expertises <span>→</span></a>
      </div>
      <ul class="mt-14 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
        {expertises.map((e, i) => (
          <li class="card-lux group relative" data-reveal style={`--i:${i}`}>
            <div class="card-media aspect-[4/3] overflow-hidden sm:aspect-[4/5] rounded-[var(--radius-photo)] bg-[var(--color-mist)]">
              <Photo name={e.photo} sizes="(min-width:1024px) 22vw, (min-width:640px) 45vw, 100vw" widths={[400, 600, 800]} class="h-full w-full object-cover" />
            </div>
            <p class="num mt-6 text-[0.9rem]">{e.num}</p>
            <h3 class="mt-2 text-[1.375rem] text-[var(--color-navy)]">
              <a href={`/expertises/#${e.id}`} class="no-underline after:absolute after:inset-0">{e.title}</a>
            </h3>
            <p class="mt-2 text-[0.98rem] leading-relaxed text-[var(--color-muted)]">{e.text}</p>
            <span class="link-more mt-4" aria-hidden="true">Découvrir <span>→</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-24 lg:py-32" aria-labelledby="process-title">
    <div class="container-lux">
      <div data-reveal>
        <p class="eyebrow text-[var(--color-teal-ink)]">Notre méthode</p>
        <h2 id="process-title" class="mt-5 max-w-2xl text-[var(--color-navy)]">Un processus clair, du premier rendez-vous à l’ouverture.</h2>
      </div>
      <div class="mt-16"><ProcessSteps /></div>
    </div>
  </section>

  <!-- RÉALISATIONS -->
  <section class="bg-[var(--color-mist)] py-24 lg:py-32" aria-labelledby="real-title">
    <div class="container-lux">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div data-reveal>
          <p class="eyebrow text-[var(--color-teal-ink)]">Réalisations</p>
          <h2 id="real-title" class="mt-5 max-w-xl text-[var(--color-navy)]">Des espaces pensés pour soigner.</h2>
        </div>
        {realisations.length > 0 && <a href="/realisations/" class="link-more self-start md:self-auto">Toutes les réalisations <span>→</span></a>}
      </div>
      {realisations.length > 0 ? (
        <div class="mt-14 grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
          {realisations.slice(0, 3).map((r, i) => <RealisationCard entry={r} i={i} />)}
        </div>
      ) : (
        <div class="mt-14 grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <figure class="lg:col-span-7" data-reveal>
            <div class="aspect-[16/10] overflow-hidden rounded-[var(--radius-photo)] bg-white">
              <Photo name="cabinetDentaire" sizes="(min-width:1024px) 55vw, 100vw" widths={[640, 960, 1280]} class="h-full w-full object-cover" />
            </div>
            <figcaption class="mt-3 text-[0.8rem] text-[var(--color-muted)]">Image d’illustration, ne représente pas un projet Euro Space Medical</figcaption>
          </figure>
          <div class="lg:col-span-5" data-reveal style="--i:1">
            <h3 class="text-[1.5rem] text-[var(--color-navy)]">Nos études de cas arrivent.</h3>
            <p class="mt-4 text-[1.02rem] leading-relaxed text-[var(--color-muted)]">Chaque projet sera présenté avec sa spécialité, sa ville et ses photos avant et après. Nous vous présentons des projets comparables au vôtre en rendez-vous.</p>
            <a href="/contact/" class="btn btn-primary mt-8">Parler de mon projet <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- POURQUOI ESM -->
  <section class="bg-white py-24 lg:py-32" aria-labelledby="why-title">
    <div class="container-lux">
      <div data-reveal>
        <p class="eyebrow text-[var(--color-teal-ink)]">Pourquoi ESM</p>
        <h2 id="why-title" class="mt-5 max-w-2xl text-[var(--color-navy)]">Le regard d’un architecte, la rigueur d’un ingénieur.</h2>
      </div>
      <ul class="mt-14 grid gap-12 md:grid-cols-3 md:gap-10">
        {why.map((w, i) => (
          <li class="border-t-2 border-[var(--color-navy)] pt-7" data-reveal style={`--i:${i}`}>
            <h3 lang="en" class="text-[1.375rem] text-[var(--color-navy)]">{w.t}</h3>
            <p class="mt-3 max-w-sm text-[1rem] leading-relaxed text-[var(--color-muted)]">{w.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    context="Accueil"
    title="Let’s build your next medical space."
    titleLang="en"
    text="Vous avez un projet de cabinet, de clinique ou de centre médical ?"
    photo="cabinetDentaire3"
  />
</BaseLayout>

---
/**
 * Accueil : défilement normal partout (aucune section épinglée, aucun effet piloté par le défilement).
 * 1. Héros — titre + brief de projet en une phrase (formulaire GET vers /contact/, pré-rempli) ; à côté, la maquette 3D
 *    se construit seule (plan → réseaux → murs → coupe équipée → PV), étapes cliquables, bouton pause (WCAG 2.2.2).
 * 2. Expertises — quatre bandes d'images repliées ; un clic ouvre la bande (desktop) ou l'accordéon (mobile).
 * 3. Pourquoi ESM — comparatif « Plusieurs prestataires / Avec ESM ».
 * 4. Spécialités — plan d'un centre médical ; chaque pièce ouvre un panneau (page virtuelle, URL réelle conservée).
 * 5. Réalisations — photos plein écran (collantes) qui changent au fil du défilement ; sur chaque photo, l'essentiel :
 *    numéro, spécialité, trois contraintes clés, actions.
 * Sans WebGL, appareil peu puissant ou « réduire les animations » : plan statique, même contenu.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Visual from '@/components/Visual.astro';
import PlanArt from '@/components/PlanArt.astro';
import SpecPlan from '@/components/SpecPlan.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CtaBand from '@/components/CtaBand.astro';
import RealisationCard from '@/components/RealisationCard.astro';
import { site, BANK_DISCLAIMER, whatsappLink } from '@/config/site';
import { getRealisations, getServices, getSpecialites, servicePath, specialitePath } from '@/lib/content';
import { expertises, specialiteVisual } from '@/lib/photos';

const realisations = await getRealisations();
const specialites = await getSpecialites();
const services = await getServices();
const serviceName = new Map(services.map((s) => [s.id, s.data.short]));
const chapters = [
  { num: '01', title: 'Concevoir', text: 'Plan coté, circuits patients séparés, emprise de chaque équipement.' },
  { num: '02', title: 'Construire', text: 'Réseaux encastrés, cloisons et menuiseries, contrôlés lot par lot.' },
  { num: '03', title: 'Équiper', text: 'Fauteuils, stérilisation, compresseur : tout est prévu dès les plans.' },
  { num: '04', title: 'Livrer', text: 'Réception pièce par pièce, procès-verbal et dossier des ouvrages.' },
];
const compare = [
  { t: 'Interlocuteurs', without: 'Architecte, entreprises, fournisseurs et banque : un contact par métier.', with: 'Un interlocuteur unique, de la première esquisse à l’ouverture.' },
  { t: 'Plans', without: 'Un plan générique, adapté ensuite à l’activité.', with: 'Le plan part de l’acte médical et des règles de votre spécialité.' },
  { t: 'Équipements', without: 'Choisis après les travaux, réseaux à reprendre.', with: 'Prévus dès les plans : fluides et électricité dimensionnés.' },
  { t: 'Budget', without: 'Des devis séparés, des écarts découverts en chantier.', with: 'Un budget par lot, validé avant le démarrage des travaux.' },
  { t: 'Rénovation', without: 'Le cabinet ferme pendant toute la durée des travaux.', with: 'Des travaux phasés en site occupé quand votre activité le permet.' },
  { t: 'Financement', without: 'Un dossier bancaire à monter seul.', with: 'Un dossier préparé et suivi avec nos banques partenaires.*' },
];
const wa = whatsappLink('Bonjour, je souhaite parler de mon projet (Accueil).');
const cities = ['Casablanca', 'Rabat', 'Marrakech', 'Tanger', 'Fès', 'Agadir', 'Meknès', 'Oujda', 'Kénitra', 'Tétouan', 'El Jadida', 'Laâyoune'];
const projectIds = ['cabinet-dentaire-orthodontie', 'gastro-enterologie-endoscopie', 'cliniques-blocs-operatoires', 'laboratoire-analyses-medicales'];
const projects = projectIds.map((id) => specialites.find((s) => s.id === id)).filter((s) => s !== undefined);
---

<BaseLayout
  title={site.name}
  description="Conception, construction, rénovation et équipement de cabinets, cliniques, centres d’imagerie et laboratoires, partout au Maroc, de l’étude à la livraison."
  context="Accueil"
>
  <!-- 1. HÉROS : brief de projet + maquette 3D qui se construit seule -->
  <section id="journey" class="journey" aria-labelledby="hero-title">
    <div class="container-lux journey-grid">
      <div class="journey-intro">
        <p class="journey-kicker"><span lang="en">Designing medical spaces.</span><i aria-hidden="true"></i><span>Partout au Maroc</span></p>
        <h1 id="hero-title" class="journey-title">
          <span class="ln"><span>Des espaces conçus </span></span><span class="ln"><span>pour mieux <em>soigner.</em></span></span>
        </h1>
        <p class="journey-lede">De la conception architecturale à l’équipement, nous accompagnons vos projets médicaux de A à Z.</p>

        <form class="brief" action="/contact/" method="get" aria-labelledby="brief-title">
          <p id="brief-title" class="brief-label">Votre projet en une phrase</p>
          <p class="brief-line">
            Je prépare une
            <label class="brief-field"><span class="sr-only">Nature du projet</span>
              <select name="nature">
                <option value="Création">création</option>
                <option value="Rénovation">rénovation</option>
                <option value="Extension">extension</option>
              </select>
            </label>
            en
            <label class="brief-field"><span class="sr-only">Spécialité</span>
              <select name="specialite">
                {specialites.map((s) => <option value={s.id}>{s.data.short.toLowerCase()}</option>)}
              </select>
            </label>
            à
            <label class="brief-field brief-city"><span class="sr-only">Ville</span>
              <input name="ville" list="brief-cities" placeholder="votre ville" autocomplete="address-level2" maxlength="60" />
            </label>.
          </p>
          <datalist id="brief-cities">
            {cities.map((c) => <option value={c} />)}
          </datalist>
          <div class="brief-actions">
            <button type="submit" class="brief-go"><span>Lancer mon projet</span><span class="brief-go-arrow" aria-hidden="true">→</span></button>
            {wa && <a href={wa} target="_blank" rel="noopener" class="brief-alt">ou écrivez-nous sur WhatsApp</a>}
          </div>
        </form>
      </div>

      <div class="journey-scene">
        <div class="journey-slot">
          <div class="journey-frame" data-journey-frame>
            <div class="journey-fallback" aria-hidden="true">
              <PlanArt variant="cabinet-dentaire-orthodontie" tone="light" class="h-full w-full" label="" />
            </div>
            <canvas class="journey-canvas" aria-hidden="true"></canvas>
            <!-- Introduction plein écran (première visite) -->
            <div class="intro-ui">
              <p class="intro-brand"><span>ESM</span> Du plan à l’ouverture</p>
              <button type="button" class="intro-skip" data-intro-skip><span data-skip-label>Passer l’introduction</span> <span aria-hidden="true">→</span></button>
              <div class="intro-caption" aria-live="polite">
                <p class="intro-num"><span data-intro-num>01</span> / 04</p>
                <p class="intro-title" data-intro-title>{chapters[0]?.title}</p>
                <p class="intro-text" data-intro-text>{chapters[0]?.text}</p>
                <div class="intro-bars" aria-hidden="true">{chapters.map(() => <span><i data-intro-bar></i></span>)}</div>
              </div>
            </div>
            <div class="journey-controls">
              <button type="button" class="journey-replay" data-journey-replay>
                <span class="journey-replay-icon" aria-hidden="true">↻</span> Revoir la construction
              </button>
              <button type="button" class="journey-pause" data-journey-pause aria-pressed="false" aria-label="Mettre l’animation en pause">
                <span class="journey-pause-icon" aria-hidden="true"></span>
              </button>
            </div>
          </div>
        </div>
        <ol class="journey-steps" aria-label="Du plan à la livraison">
          {chapters.map((c, i) => (
            <li class:list={['journey-step', i === 0 && 'is-active']} data-step={i}>
              <button type="button" class="journey-step-btn" data-goto={i}>
                <span class="journey-step-bar" aria-hidden="true"><i data-step-bar></i></span>
                <span class="journey-step-num">{c.num}</span>
                <span class="journey-step-title">{c.title}</span>
              </button>
              <p class="journey-step-text">{c.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 2. EXPERTISES : bandes d'images repliées, ouvertes au clic -->
  <section data-strips class="strips bg-[var(--color-navy)] text-white" aria-labelledby="expertises-title">
    <div class="strips-inner">
      <div class="container-lux strips-head">
        <div>
          <p class="eyebrow text-[var(--color-gold)]">Expertises</p>
          <h2 id="expertises-title" class="mt-5 text-white">Quatre expertises, un seul partenaire.</h2>
        </div>
        <a href="/expertises/" class="link-more text-white">Toutes nos expertises <span>→</span></a>
      </div>
      <ul class="strips-row" aria-label="Nos quatre expertises">
        {expertises.map((e) => (
          <li class="strip" data-strip>
            <div class="strip-media" aria-hidden="true">
              <Visual visual={e.visual} sizes="(min-width:1024px) 60vw, 100vw" widths={[640, 1000, 1400]} />
            </div>
            <div class="strip-shade" aria-hidden="true"></div>
            <button type="button" class="strip-toggle" data-strip-toggle aria-expanded="false" aria-controls={`strip-${e.id}`}>
              <span class="strip-tab"><span class="strip-tab-num">{e.num}</span><span class="strip-tab-title">{e.title}</span></span>
              <span class="strip-plus" aria-hidden="true"></span>
              <span class="sr-only">Afficher le détail</span>
            </button>
            <div class="strip-body" id={`strip-${e.id}`}>
              <span class="strip-num" aria-hidden="true">{e.num}</span>
              <h3 class="strip-title"><a href={`/expertises/#${e.id}`}>{e.title}</a></h3>
              <p class="strip-text">{e.text}</p>
              <ul class="strip-services" aria-label={`Services : ${e.title}`}>
                {e.services.map((id) => (
                  <li><a href={servicePath(id)}><span>{serviceName.get(id) ?? id}</span><span aria-hidden="true">→</span></a></li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. POURQUOI ESM : comparatif -->
  <section class="bg-white py-24 lg:py-32" aria-labelledby="why-title">
    <div class="container-lux grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="min-w-0 lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <p class="eyebrow text-[var(--color-teal-ink)]">Pourquoi ESM</p>
          <h2 id="why-title" class="mt-6">Un seul interlocuteur change tout.</h2>
          <p class="mt-5 max-w-sm text-[1.05rem] leading-relaxed text-[var(--color-muted)]">Le regard d’un architecte, la rigueur d’un ingénieur, et une équipe qui tient le fil du premier plan à l’ouverture.</p>
          <a href="/contact/" class="btn btn-primary mt-8">Parler de mon projet <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="min-w-0 lg:col-span-8">
        <table class="compare">
          <caption class="sr-only">Un projet médical mené avec plusieurs prestataires, ou avec Euro Space Medical</caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Sujet</span></th>
              <th scope="col">Plusieurs prestataires</th>
              <th scope="col" class="compare-esm">Avec ESM</th>
            </tr>
          </thead>
          <tbody tabindex="0" aria-label="Comparatif, faites défiler">
            {compare.map((r, i) => (
              <tr data-reveal style={`--i:${i % 3}`}>
                <th scope="row">{r.t}</th>
                <td class="compare-without" data-label="Plusieurs prestataires">{r.without}</td>
                <td class="compare-with" data-label="Avec ESM">{r.with}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="compare-hint" aria-hidden="true">Faites glisser pour comparer →</p>
        <p class="mt-5 text-[0.85rem] text-[var(--color-muted)]">* Al Barid Bank et Bank Al Yousr. {BANK_DISCLAIMER}</p>
      </div>
    </div>
  </section>

  <!-- Bandeau défilant (décoratif) -->
  <div class="marquee bg-[var(--color-warm)]" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <span class="marquee-group">
          {specialites.map((s) => <span class="marquee-item">{s.data.short}<i></i></span>)}
        </span>
      ))}
    </div>
  </div>

  <!-- 4. SPÉCIALITÉS : le plan d'un centre médical -->
  <section class="bg-[var(--color-warm)] pb-24 pt-20 lg:pb-32 lg:pt-28" aria-labelledby="spec-title">
    <div class="container-lux">
      <SectionHeading eyebrow="Spécialités" title="Chaque spécialité a ses règles." id="spec-title" intro="Quatorze disciplines, chacune avec son plan type, ses réseaux et ses autorisations. Ouvrez une pièce pour la découvrir." link={{ href: '/specialites/', label: 'Toutes les spécialités' }} />
      <div class="mt-12">
        <SpecPlan items={specialites.map((s) => ({
          id: s.id,
          short: s.data.short,
          h1: s.data.h1,
          description: s.data.description,
          contraintes: s.data.contraintes,
          offre: s.data.offre,
          aValider: s.data.aValider,
          services: s.data.servicesLies.map((id) => ({ id, label: serviceName.get(id) ?? id })),
        }))} />
      </div>
    </div>
  </section>

  <!-- 5. RÉALISATIONS : l'image change au fil du défilement (défilement normal, rien d'épinglé) -->
  {realisations.length > 0 ? (
    <section class="bg-white py-24 lg:py-32" aria-labelledby="real-title">
      <div class="container-lux">
        <SectionHeading eyebrow="Réalisations" title="Des espaces pensés pour soigner." id="real-title" link={{ href: '/realisations/', label: 'Toutes les réalisations' }} />
        <div class="mt-14 grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
          {realisations.slice(0, 3).map((r, i) => <RealisationCard entry={r} i={i} />)}
        </div>
      </div>
    </section>
  ) : (
    <section class="cases" aria-labelledby="real-title" data-cases>
      <div class="cases-stage" aria-hidden="true">
        {projects.map((s, i) => (
          <div class:list={['cases-media', i === 0 && 'is-active']} data-case-media={i}>
            <Visual visual={specialiteVisual[s.id] ?? { drawing: s.id, label: 'Plan type' }} sizes="100vw" widths={[800, 1280, 1920, 2400]} />
          </div>
        ))}
        <div class="cases-veil"></div>
        <p class="cases-count"><span data-case-count>01</span> / {String(projects.length).padStart(2, '0')}</p>
        <p class="cases-caption">Images d’illustration</p>
      </div>
      <div class="cases-track">
        <div class="cases-panel cases-panel--intro" data-case="0">
          <div class="container-lux">
            <p class="eyebrow text-[var(--color-gold)]">Réalisations</p>
            <h2 id="real-title" class="cases-head-title">Les projets que nous menons.</h2>
            <p class="cases-head-text">Nos études de cas arrivent. Voici les projets types que nous concevons, construisons et équipons.</p>
          </div>
        </div>
        <ol class="cases-list" aria-label="Projets types">
          {projects.map((s, i) => (
            <li class="cases-panel" data-case={i}>
              <div class="container-lux">
                <p class="cases-kicker">Projet type <span>{String(i + 1).padStart(2, '0')}</span></p>
                <h3 class="cases-title"><a href={specialitePath(s.id)}>{s.data.short}</a></h3>
                <ul class="cases-chips" aria-label="Contraintes clés">
                  {s.data.contraintes.slice(0, 3).map((c) => <li>{c.split(/[:;(]/)[0]?.trim()}</li>)}
                </ul>
                <div class="cases-actions">
                  <a href={`/contact/?specialite=${s.id}`} class="cases-cta">Démarrer un projet similaire <span aria-hidden="true">→</span></a>
                  <a href={specialitePath(s.id)} class="link-more text-white">La spécialité <span>→</span></a>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <CtaBand context="Accueil" title="Construisons votre prochain espace médical." text="Vous avez un projet de cabinet, de clinique ou de centre médical ?" photo="cabinetDentaire3" />
</BaseLayout>

<script>
  import '@/scripts/motion-home';
</script>

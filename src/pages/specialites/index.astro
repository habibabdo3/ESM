---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SpecIndex from '@/components/SpecIndex.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getSpecialites } from '@/lib/content';
import { breadcrumb } from '@/lib/schema';

const specialites = await getSpecialites();
const base = Astro.site!;
const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Spécialités', path: '/specialites/' }];
---
<BaseLayout
  title="Aménagement par spécialité médicale"
  description="Dentaire, imagerie, ophtalmologie, ORL, gynécologie, pédiatrie, cardiologie, laboratoires, blocs opératoires : un aménagement adapté à chaque spécialité."
  jsonld={[breadcrumb(base, crumbs)]}
  context="Spécialités"
>
  <PageHero eyebrow="Spécialités" h1="Quatorze spécialités, autant d’exigences" intro="Radioprotection, salles propres, fluides, acoustique, étanchéité : le plan part de l’acte médical. Choisissez votre discipline pour découvrir ses contraintes et notre offre." crumbs={crumbs} />
  <section class="py-20 lg:py-28">
    <div class="container-lux">
      <SpecIndex items={specialites.map((s) => ({ id: s.id, short: s.data.short, sub: s.data.contraintes[0] }))}>
        <h2 class="max-w-xl">Choisissez votre discipline.</h2>
        <p class="mt-5 max-w-md text-[1.05rem] leading-relaxed text-[var(--color-muted)]">Survolez une spécialité pour voir son plan type, ouvrez-la pour ses contraintes et notre offre.</p>
      </SpecIndex>
    </div>
  </section>
  <CtaBand context="Spécialités" />
</BaseLayout>

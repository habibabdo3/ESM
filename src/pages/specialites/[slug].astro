---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PlanArt from '@/components/PlanArt.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import RealisationCard from '@/components/RealisationCard.astro';
import { getServices, getSpecialites, getRealisations, servicePath, specialitePath, pad, paragraphs, type Specialite } from '@/lib/content';
import { specialiteVisual } from '@/lib/photos';
import { breadcrumb, faqPage, service as serviceLd } from '@/lib/schema';

export async function getStaticPaths() {
  const specialites = await getSpecialites();
  return specialites.map((s) => ({ params: { slug: s.id }, props: { entry: s } }));
}
const { entry } = Astro.props as { entry: Specialite };
const d = entry.data;
const base = Astro.site!;
const path = specialitePath(entry.id);
const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Spécialités', path: '/specialites/' }, { name: d.short, path }];

const services = (await getServices()).filter((s) => d.servicesLies.includes(s.id));
const all = await getSpecialites();
const neighbours = [all[(d.order) % all.length]!, all[(d.order + 1) % all.length]!];
const hasPhotoHero = 'photo' in specialiteVisual[entry.id]!;
const realisations = (await getRealisations()).filter((r) => r.data.specialite === entry.id).slice(0, 3);
---
<BaseLayout
  title={d.title}
  description={d.description}
  context={d.short}
  jsonld={[breadcrumb(base, crumbs), serviceLd(base, { name: d.h1, description: d.description, path, type: `Aménagement — ${d.short}` }), ...(d.faq.length ? [faqPage(d.faq)] : [])]}
>
  <PageHero eyebrow={`Spécialité ${pad(d.order)} · ${d.short}`} h1={d.h1} intro={d.description} crumbs={crumbs} visual={specialiteVisual[entry.id]} ctaLabel={d.cta} ctaHref={`/contact/?specialite=${entry.id}`} />

  <section class="py-20 lg:py-28">
    <div class="container-lux grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6" data-reveal>
        <p class="eyebrow text-[var(--color-teal-ink)]">Notre approche</p>
        <h2 class="mt-5">Un plan pensé pour votre pratique</h2>
        <div class="mt-8 space-y-4 text-[1.06rem] leading-relaxed text-[var(--color-ink)]">
          {paragraphs(d.intro).map((t) => <p>{t}</p>)}
        </div>
        {hasPhotoHero && (
          <>
            <h3 class="mt-14 text-[1.375rem]">Contraintes d’aménagement</h3>
            <ul class="mt-6 space-y-4">
              {d.contraintes.map((c) => (
                <li class="flex gap-4 border-b border-[var(--color-line)] pb-4"><span class="mt-3 block h-px w-6 shrink-0 bg-[var(--color-teal)]"></span><span>{c}</span></li>
              ))}
            </ul>
          </>
        )}
      </div>
      <div class="lg:col-span-6" data-reveal style="--i:1">
        {hasPhotoHero ? (
          <>
            <div class="aspect-[4/3] overflow-hidden rounded-[var(--radius-photo)] bg-[var(--color-mist)]">
              <PlanArt variant={entry.id} tone="light" class="h-full w-full" label={`Illustration : plan schématique type — ${d.short}`} />
            </div>
            <p class="mt-2.5 text-[0.78rem] text-[var(--color-muted)]">Plan schématique type · {d.short} · illustration non contractuelle</p>
          </>
        ) : (
          <div class="border border-[var(--color-line)] bg-white p-8 lg:p-10">
            <p class="eyebrow text-[var(--color-teal-ink)]">L’essentiel technique</p>
            <h3 class="mt-4 text-[1.375rem]">Contraintes d’aménagement</h3>
            <ul class="mt-6 space-y-4">
              {d.contraintes.map((c) => (
                <li class="flex gap-4 border-b border-[var(--color-line)] pb-4 last:border-0 last:pb-0"><span class="mt-3 block h-px w-6 shrink-0 bg-[var(--color-teal)]"></span><span>{c}</span></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-navy)] py-20 text-white lg:py-28">
    <div class="container-lux grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow text-[var(--color-gold)]">Ce que nous proposons</p>
        <h2 class="mt-6">Notre offre</h2>
        <p class="mt-6 text-[var(--color-warm)]/70">Les surfaces et références techniques sont des repères, confirmés sur plan avec le bureau d’études.</p>
      </div>
      <ol class="grid gap-px overflow-hidden bg-[var(--color-navy-3)] sm:grid-cols-2 lg:col-span-8">
        {d.offre.map((o, i) => (
          <li class="bg-[var(--color-navy)] p-7" data-reveal style={`--i:${i % 2}`}>
            <span class="num text-3xl">{pad(i + 1)}</span>
            <p class="mt-4 text-[1.02rem] text-[var(--color-warm)]/90">{o}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="container-lux grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow text-[var(--color-teal-ink)]">Réglementation</p>
        <h2 class="mt-6">Autorisations et points à valider</h2>
      </div>
      <div class="lg:col-span-8" data-reveal style="--i:1">
        <ul class="space-y-4">
          {d.aValider.map((a) => (
            <li class="flex gap-4 border border-[var(--color-line)] bg-white/40 p-5"><span class="text-[var(--color-teal-ink)]" aria-hidden="true">◆</span><span>{a}</span></li>
          ))}
        </ul>
        <p class="mt-6 text-[0.88rem] text-[var(--color-muted)]">Ces points sont validés pour chaque projet avec les autorités compétentes, votre bureau d’études et l’organisme de contrôle.</p>
      </div>
    </div>
  </section>

  {d.lexique.length > 0 && (
    <section class="bg-[var(--color-navy)] py-20 text-[var(--color-warm)] lg:py-28" aria-labelledby="lexique-title">
      <div class="container-lux grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-4" data-reveal>
          <p class="eyebrow text-[var(--color-gold)]">Notre langage commun</p>
          <h2 id="lexique-title" class="mt-6">Le vocabulaire de votre spécialité</h2>
          <p class="mt-6 text-[var(--color-warm)]/70">Nous parlons le langage de votre pratique : chaque équipement, chaque examen, chaque exigence technique est pris en compte dès le premier plan.</p>
          <a href="/glossaire/" class="btn btn-ghost-light mt-8">Tout le glossaire</a>
        </div>
        <dl class="grid gap-px overflow-hidden bg-[var(--color-navy-3)] sm:grid-cols-2 lg:col-span-8">
          {d.lexique.map((t, i) => (
            <div class="bg-[var(--color-navy)] p-7" data-reveal style={`--i:${i % 2}`}>
              <dt class="display text-[1.5rem] text-[var(--color-gold-soft)]">{t.terme}</dt>
              <dd class="mt-3 text-[0.95rem] leading-relaxed text-[var(--color-warm)]/75">{t.definition}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  {realisations.length > 0 && (
    <section class="bg-[var(--color-mist)] py-20 lg:py-28">
      <div class="container-lux">
        <h2>Réalisations — {d.short}</h2>
        <div class="mt-12 grid gap-10 md:grid-cols-3">{realisations.map((r, i) => <RealisationCard entry={r} i={i} />)}</div>
      </div>
    </section>
  )}

  <Faq items={d.faq} tone="sand" />

  <section class="py-20 lg:py-28">
    <div class="container-lux grid gap-16 lg:grid-cols-2">
      <RelatedLinks title="Services liés" links={services.map((s) => ({ href: servicePath(s.id), label: s.data.short, meta: `Service ${pad(s.data.order)}` }))} />
      <RelatedLinks title="Autres spécialités" links={neighbours.map((s) => ({ href: specialitePath(s.id), label: s.data.short, meta: 'Spécialité' })).concat([{ href: '/renovation-cabinet-clinique/', label: 'Rénovation en site occupé', meta: 'Méthode' }])} />
    </div>
  </section>

  <CtaBand context={d.short} title={d.cta} />
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PlanArt from '@/components/PlanArt.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import RealisationCard from '@/components/RealisationCard.astro';
import { getServices, getSpecialites, getRealisations, servicePath, specialitePath, pad, type Specialite } from '@/lib/content';
import { breadcrumb, faqPage, service as serviceLd } from '@/lib/schema';

export async function getStaticPaths() {
  const specialites = await getSpecialites();
  return specialites.map((s) => ({ params: { slug: s.id }, props: { entry: s } }));
}
const { entry } = Astro.props as { entry: Specialite };
const d = entry.data;
const base = Astro.site!;
const path = specialitePath(entry.id);
const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Spécialités', path: '/specialites/' }, { name: d.short, path }];

const services = (await getServices()).filter((s) => d.servicesLies.includes(s.id));
const all = await getSpecialites();
const neighbours = [all[(d.order) % all.length]!, all[(d.order + 1) % all.length]!];
const realisations = (await getRealisations()).filter((r) => r.data.specialite === entry.id).slice(0, 3);
---
<BaseLayout
  title={d.title}
  description={d.description}
  context={d.short}
  jsonld={[breadcrumb(base, crumbs), serviceLd(base, { name: d.h1, description: d.description, path, type: `Aménagement — ${d.short}` }), ...(d.faq.length ? [faqPage(d.faq)] : [])]}
>
  <PageHero eyebrow={`Spécialité ${pad(d.order)} · ${d.short}`} h1={d.h1} intro={d.intro} crumbs={crumbs} variant={entry.id} ctaLabel={d.cta} ctaHref={`/contact/?specialite=${entry.id}`} />

  <section class="py-20 lg:py-28">
    <div class="container-lux grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-6" data-reveal>
        <p class="eyebrow text-[var(--color-gold-deep)]">Contraintes</p>
        <h2 class="mt-6">Contraintes d’aménagement</h2>
        <ul class="mt-10 space-y-5">
          {d.contraintes.map((c) => (
            <li class="flex gap-4 border-b border-[var(--color-line)] pb-5"><span class="mt-3 block h-px w-6 shrink-0 bg-[var(--color-gold-deep)]"></span><span>{c}</span></li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-6">
        <div class="aspect-[4/3] overflow-hidden rounded-[var(--radius-photo)]" data-reveal-img>
          <div class="h-full w-full"><PlanArt variant={entry.id} class="h-full w-full" label={`Illustration : plan schématique type — ${d.short}`} /></div>
        </div>
        <p class="caption mt-3 text-[var(--color-stone-ink)]">Plan schématique · {d.short} · illustration non contractuelle</p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-night)] py-20 text-[var(--color-ivory)] lg:py-28">
    <div class="container-lux grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow text-[var(--color-gold)]">Ce que nous proposons</p>
        <h2 class="mt-6">Notre offre</h2>
        <p class="mt-6 text-[var(--color-ivory)]/70">Les surfaces et références techniques sont des repères, confirmés sur plan avec notre bureau d’études.</p>
      </div>
      <ol class="grid gap-px overflow-hidden bg-[var(--color-night-3)] sm:grid-cols-2 lg:col-span-8">
        {d.offre.map((o, i) => (
          <li class="bg-[var(--color-night)] p-7" data-reveal style={`--i:${i % 2}`}>
            <span class="num text-3xl">{pad(i + 1)}</span>
            <p class="mt-4 text-[1.02rem] text-[var(--color-ivory)]/90">{o}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="container-lux grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow text-[var(--color-gold-deep)]">Réglementation</p>
        <h2 class="mt-6">Autorisations et points à valider</h2>
      </div>
      <div class="lg:col-span-8" data-reveal style="--i:1">
        <ul class="space-y-4">
          {d.aValider.map((a) => (
            <li class="flex gap-4 border border-[var(--color-line)] bg-white/40 p-5"><span class="text-[var(--color-gold-deep)]" aria-hidden="true">◆</span><span>{a}</span></li>
          ))}
        </ul>
        <p class="mt-6 text-[0.88rem] text-[var(--color-stone-ink)]">Ces points sont validés pour chaque projet avec les autorités compétentes, votre bureau d’études et l’organisme de contrôle.</p>
      </div>
    </div>
  </section>

  {realisations.length > 0 && (
    <section class="bg-[var(--color-sand)] py-20 lg:py-28">
      <div class="container-lux">
        <h2>Réalisations — {d.short}</h2>
        <div class="mt-12 grid gap-10 md:grid-cols-3">{realisations.map((r, i) => <RealisationCard entry={r} i={i} />)}</div>
      </div>
    </section>
  )}

  <Faq items={d.faq} tone="sand" />

  <section class="py-20 lg:py-28">
    <div class="container-lux grid gap-16 lg:grid-cols-2">
      <RelatedLinks title="Services liés" links={services.map((s) => ({ href: servicePath(s.id), label: s.data.short, meta: `Service ${pad(s.data.order)}` }))} />
      <RelatedLinks title="Autres spécialités" links={neighbours.map((s) => ({ href: specialitePath(s.id), label: s.data.short, meta: 'Spécialité' })).concat([{ href: '/renovation-cabinet-clinique/', label: 'Rénovation en site occupé', meta: 'Méthode' }])} />
    </div>
  </section>

  <CtaBand context={d.short} title={d.cta} />
</BaseLayout>

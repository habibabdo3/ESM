---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Photo from '@/components/Photo.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getServices, getSpecialites, servicePath, specialitePath } from '@/lib/content';
import { expertises } from '@/lib/photos';
import { breadcrumb } from '@/lib/schema';

const services = await getServices();
const specialites = await getSpecialites();
const byId = new Map(services.map((s) => [s.id, s]));
const extras: Record<string, { href: string; label: string }[]> = {
  'construction-renovation': [{ href: '/renovation-cabinet-clinique/', label: 'Notre méthode de rénovation en site occupé' }],
  'accompagnement-global': [
    { href: '/financement/', label: 'Financement avec nos banques partenaires' },
    { href: '/premiere-installation/', label: 'Première installation' },
    { href: '/zones-intervention/', label: 'Zones d’intervention' },
  ],
};
const base = Astro.site!;
const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Expertises', path: '/expertises/' }];
---
<BaseLayout
  title="Nos expertises en aménagement médical"
  description="Étude et conception, construction et rénovation, équipement médical, accompagnement global : quatre expertises pour réaliser votre projet médical au Maroc."
  jsonld={[breadcrumb(base, crumbs)]}
  context="Expertises"
>
  <PageHero eyebrow="Expertises" h1="Quatre expertises, un seul partenaire." intro="De la première étude à l’ouverture, nous réunissons conception, travaux, équipement et accompagnement." crumbs={crumbs} photo="couloirArchitecture" />

  <nav aria-label="Expertises" class="border-b border-[var(--color-line)] bg-white">
    <ul class="container-lux flex gap-8 overflow-x-auto py-5 text-[0.95rem] font-semibold text-[var(--color-navy)]">
      {expertises.map((e) => <li class="shrink-0"><a href={`#${e.id}`} class="link-lux"><span class="num mr-2 text-[0.85rem]">{e.num}</span>{e.title}</a></li>)}
    </ul>
  </nav>

  {expertises.map((e, i) => {
    const list = e.services.map((id) => byId.get(id)).filter((s) => s !== undefined);
    return (
      <section id={e.id} class:list={['scroll-mt-24 py-20 lg:py-28', i % 2 ? 'bg-white' : '']} aria-labelledby={`${e.id}-t`}>
        <div class="container-lux grid items-start gap-10 lg:grid-cols-12 lg:gap-16">
          <div class:list={['lg:col-span-5', i % 2 && 'lg:order-2']} data-reveal>
            <div class="aspect-[4/3] overflow-hidden rounded-[var(--radius-photo)] bg-[var(--color-mist)]">
              <Photo name={e.photo} sizes="(min-width:1024px) 40vw, 100vw" widths={[480, 800, 1200]} class="h-full w-full object-cover" />
            </div>
          </div>
          <div class:list={['lg:col-span-7', i % 2 && 'lg:order-1']} data-reveal style="--i:1">
            <p class="num text-[0.95rem]">{e.num}</p>
            <h2 id={`${e.id}-t`} class="mt-3 text-[var(--color-navy)]">{e.title}</h2>
            <p class="mt-4 max-w-xl text-[1.1rem] text-[var(--color-muted)]">{e.text}</p>
            <ul class="mt-10 divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
              {list.map((s) => (
                <li>
                  <a href={servicePath(s.id)} class="group flex items-center justify-between gap-6 py-5 no-underline">
                    <span>
                      <span class="block font-[family-name:var(--font-display)] text-[1.15rem] font-semibold text-[var(--color-navy)] transition-colors group-hover:text-[var(--color-teal-ink)]">{s.data.short}</span>
                      <span class="mt-1 block text-[0.92rem] text-[var(--color-muted)]">{s.data.termes.slice(0, 3).join(' · ')}</span>
                    </span>
                    <span class="text-[var(--color-teal-ink)] transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
              {(extras[e.id] ?? []).map((x) => (
                <li>
                  <a href={x.href} class="group flex items-center justify-between gap-6 py-5 no-underline">
                    <span class="font-[family-name:var(--font-display)] text-[1.15rem] font-semibold text-[var(--color-navy)] transition-colors group-hover:text-[var(--color-teal-ink)]">{x.label}</span>
                    <span class="text-[var(--color-teal-ink)] transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    );
  })}

  <section class="bg-[var(--color-mist)] py-20 lg:py-28" aria-labelledby="spec-title">
    <div class="container-lux grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow text-[var(--color-teal-ink)]">Spécialités</p>
        <h2 id="spec-title" class="mt-5 text-[var(--color-navy)]">Chaque spécialité a ses règles.</h2>
        <a href="/specialites/" class="link-more mt-6">Voir les spécialités <span>→</span></a>
      </div>
      <ul class="grid gap-x-8 sm:grid-cols-2 lg:col-span-8">
        {specialites.map((s) => (
          <li class="border-b border-[var(--color-line)]">
            <a href={specialitePath(s.id)} class="group flex items-center justify-between py-4 no-underline">
              <span class="font-medium text-[var(--color-navy)] group-hover:text-[var(--color-teal-ink)]">{s.data.short}</span>
              <span class="text-[var(--color-teal-ink)]" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-20 lg:py-28" aria-labelledby="process-title">
    <div class="container-lux">
      <p class="eyebrow text-[var(--color-teal-ink)]">Notre méthode</p>
      <h2 id="process-title" class="mt-5 max-w-2xl text-[var(--color-navy)]">Quatre étapes, les mêmes partout au Maroc.</h2>
      <div class="mt-14"><ProcessSteps /></div>
    </div>
  </section>

  <CtaBand context="Expertises" photo="blocOperatoire" />
</BaseLayout>

---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StickyCta from '@/components/StickyCta.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import Logo from '@/components/Logo.astro';
import Icon from '@/components/Icon.astro';
import { whatsappLink } from '@/config/site';
import displayFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import textFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonld?: Record<string, unknown>[];
  overlayHeader?: boolean;
  context?: string;
  /** Pages d'annonce : en-tête réduit (logo + WhatsApp), pied de page légal, barre mobile « WhatsApp / devis ». */
  minimal?: boolean;
}
const { overlayHeader = false, context, minimal = false, ...seo } = Astro.props;
const wa = minimal ? whatsappLink(`Bonjour Euro Space Medical, je consulte la page « ${context ?? seo.title} » et je souhaite parler de mon projet.`) : null;
---

<!doctype html>
<html lang="fr" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#142c43" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>(function(){var h=document.documentElement,n=navigator;h.classList.add('js');try{if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;var c=n.connection||{},m=n.deviceMemory||4,k=n.hardwareConcurrency||4;if(c.saveData||m<2)return;var g=document.createElement('canvas'),x=g.getContext('webgl2')||g.getContext('webgl');if(!x)return;var l=x.getExtension('WEBGL_lose_context');l&&l.loseContext();h.classList.add('webgl');if(m<4||k<=4||/2g|3g/.test(c.effectiveType||''))h.classList.add('gl-lite');if(location.pathname==='/'&&!location.hash&&!localStorage.getItem('esm-intro-v1')){h.classList.add('intro');setTimeout(function(){var j=document.getElementById('journey');if(h.classList.contains('intro')&&!(j&&j.classList.contains('scene-ready')))h.classList.remove('intro')},7000)}}catch(e){}})()</script>
    <Seo {...seo} />
  </head>
  <body>
    {minimal ? (
      <header class="lp-header">
        <div class="container-lux flex h-[4.5rem] items-center justify-between gap-4">
          <a href="/" aria-label="Euro Space Medical, accueil"><Logo size={40} tagline={false} /></a>
          {wa ? (
            <a href={wa} target="_blank" rel="noopener" class="lp-header-wa"><Icon name="whatsapp" size={18} /> <span>WhatsApp</span></a>
          ) : (
            <a href="#devis" class="lp-header-wa">Être rappelé</a>
          )}
        </div>
      </header>
    ) : (
      <Header overlay={overlayHeader} />
    )}
    <main id="contenu">
      <slot />
    </main>
    {minimal ? (
      <footer class="lp-footer">
        <div class="container-lux flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
          <p>© {new Date().getFullYear()} Euro Space Medical</p>
          <ul class="flex flex-wrap gap-x-5 gap-y-2">
            <li><a href="/mentions-legales/">Mentions légales</a></li>
            <li><a href="/confidentialite/">Confidentialité</a></li>
            <li><a href="/cookies/">Cookies</a></li>
            <li><button type="button" data-cookie-open>Gérer les cookies</button></li>
          </ul>
        </div>
      </footer>
      <div class="lp-sticky" style="padding-bottom: env(safe-area-inset-bottom)">
        {wa && <a href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> WhatsApp</a>}
        <a href="#devis" class="lp-sticky-devis">Recevoir mon devis</a>
      </div>
    ) : (
      <>
        <Footer />
        <StickyCta context={context ?? seo.title} />
      </>
    )}
    <CookieBanner />
    <script>import '@/scripts/motion';</script>
  </body>
</html>

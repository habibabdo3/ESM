---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { realisationPath } from '@/lib/content';
interface Props { entry: CollectionEntry<'realisations'>; i?: number }
const { entry, i = 0 } = Astro.props;
const d = entry.data;
---
<article class="card-lux group relative" data-reveal style={`--i:${i % 3}`}>
  <div class="card-media relative aspect-[4/3] overflow-hidden rounded-[var(--radius-photo)] bg-[var(--color-night)]">
    <Image src={d.apres} alt={`${d.title} — après travaux`} widths={[480, 800, 1200]} sizes="(min-width:1024px) 33vw, (min-width:768px) 50vw, 100vw" class="h-full w-full object-cover" style={`view-transition-name:real-${entry.id}`} />
    <div class="card-veil absolute inset-0 bg-[var(--color-night)]/30"></div>
  </div>
  <p class="caption mt-5 text-[var(--color-stone-ink)]">{d.ville} · {d.specialite}</p>
  <h3 class="mt-1 text-[1.6rem]"><a href={realisationPath(entry.id)} class="no-underline after:absolute after:inset-0">{d.title}</a></h3>
  <span class="card-rule mt-3 block h-px w-16 bg-[var(--color-gold)]"></span>
  <p class="mt-3 text-[0.9rem] text-[var(--color-stone-ink)]">{d.surface} m² · {d.duree}</p>
  <span class="card-more mt-4 inline-flex items-center gap-2 text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-[var(--color-gold-deep)]" aria-hidden="true">Découvrir <span>→</span></span>
</article>

---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { realisationPath, getSpecialites } from '@/lib/content';
interface Props { entry: CollectionEntry<'realisations'>; i?: number }
const { entry, i = 0 } = Astro.props;
const d = entry.data;
const spec = (await getSpecialites()).find((s) => s.id === d.specialite);
---
<article class="card-lux group relative" data-reveal style={`--i:${i % 3}`}>
  <div class="card-media aspect-[4/3] overflow-hidden rounded-[var(--radius-photo)] bg-[var(--color-mist)]">
    <Picture src={d.apres} alt={`${d.title}, après travaux`} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width:1024px) 33vw, (min-width:768px) 50vw, 100vw" class="h-full w-full object-cover" style={`view-transition-name:real-${entry.id}`} />
  </div>
  <p class="mt-5 text-[0.82rem] font-semibold text-[var(--color-teal-ink)]">{spec?.data.short ?? d.specialite}{d.categorie && ` · ${d.categorie}`}</p>
  <h3 class="mt-1.5 text-[1.375rem] text-[var(--color-navy)]"><a href={realisationPath(entry.id)} class="no-underline after:absolute after:inset-0">{d.title}</a></h3>
  <p class="mt-1 text-[0.95rem] text-[var(--color-muted)]">{d.ville}</p>
  <span class="link-more mt-4" aria-hidden="true">Voir le projet <span>→</span></span>
</article>

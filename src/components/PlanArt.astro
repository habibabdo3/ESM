---
/**
 * Illustration SVG « plan d'architecte » générée de façon déterministe.
 * Remplace les photos tant que les vraies réalisations ne sont pas disponibles.
 * Aucune donnée réelle : c'est une illustration, signalée comme telle (aria-label).
 */
interface Props {
  variant?: string;
  rooms?: string[];
  tone?: 'night' | 'light';
  class?: string;
  label?: string;
  circuit?: boolean;
  detail?: 'full' | 'simple';
}
const {
  variant = 'default',
  rooms,
  tone = 'night',
  class: cls = '',
  label = 'Illustration : plan d’aménagement schématique',
  circuit = true,
  detail = 'full',
} = Astro.props;

const roomSets: Record<string, string[]> = {
  default: ['Accueil', 'Attente', 'Consultation 1', 'Consultation 2', 'Soins', 'Technique', 'Sanitaire'],
  'cabinet-dentaire-orthodontie': ['Accueil', 'Attente', 'Fauteuil 1', 'Fauteuil 2', 'Stérilisation', 'Panoramique', 'Local tech.'],
  'radiologie-imagerie-medicale': ['Accueil', 'Attente', 'Scanner', 'Commande', 'Échographie', 'Cabines', 'Salle tech.'],
  ophtalmologie: ['Accueil', 'Attente', 'Réfraction', 'Examen', 'Imagerie OCT', 'Laser', 'Optique'],
  'orl-audiologie': ['Accueil', 'Attente', 'Cabine audio', 'Examen ORL', 'Désinfection', 'Vestibulaire', 'Stock'],
  'gynecologie-echographie-pma': ['Accueil', 'Attente', 'Examen', 'Échographie', 'Laboratoire', 'Transfert', 'Repos'],
  pediatrie: ['Accueil', 'Attente A', 'Attente B', 'Consultation', 'Soins', 'Allaitement', 'Vaccins'],
  'dermatologie-medecine-esthetique': ['Accueil', 'Salon', 'Consultation', 'Salle laser', 'Photo', 'Actes', 'Sortie'],
  'cardiologie-explorations-fonctionnelles': ['Accueil', 'Attente', 'Effort', 'Écho cœur', 'Holter', 'Consultation', 'Technique'],
  'kinesitherapie-reeducation': ['Accueil', 'Vestiaires', 'Plateau technique', 'Cabine 1', 'Cabine 2', 'Bassin', 'Stock'],
  'gastro-enterologie-endoscopie': ['Accueil', 'Préparation', 'Endoscopie', 'Réveil', 'Désinfection', 'Consultation', 'Sanitaire'],
  'laboratoire-analyses-medicales': ['Accueil', 'Prélèvement', 'Pré-analytique', 'Analytique', 'Froid', 'Archives', 'Déchets'],
  'cliniques-blocs-operatoires': ['Admission', 'Préparation', 'Bloc 1', 'Bloc 2', 'SSPI', 'Stérilisation', 'Gaz méd.'],
  'medecine-generale-cabinets-de-groupe': ['Accueil', 'Attente', 'Cabinet 1', 'Cabinet 2', 'Cabinet 3', 'Soins IDE', 'Télécons.'],
  'psychiatrie-psychologie': ['Accueil', 'Attente', 'Consultation', 'Groupe', 'Sas', 'Sortie', 'Bureau'],
};
const labels = rooms ?? roomSets[variant] ?? roomSets.default!;

let h = 0;
for (const c of variant) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const tpl = h % 3;

// Gabarits [x, y, w, h] sur une grille 400 × 260, origine (20, 20)
const templates: [number, number, number, number][][] = [
  [[0, 0, 120, 90], [0, 90, 120, 130], [120, 0, 140, 110], [260, 0, 120, 110], [120, 110, 120, 110], [240, 110, 80, 110], [320, 110, 60, 110]],
  [[0, 0, 160, 80], [160, 0, 110, 80], [270, 0, 110, 120], [0, 80, 100, 140], [100, 80, 170, 140], [270, 120, 110, 50], [270, 170, 110, 50]],
  [[0, 0, 110, 120], [110, 0, 90, 70], [200, 0, 180, 70], [110, 70, 150, 150], [260, 70, 120, 80], [0, 120, 110, 100], [260, 150, 120, 70]],
];
const rects = templates[tpl]!.slice(0, labels.length).map(([x, y, w, hh], i) => ({
  x: x + 20, y: y + 20, w, h: hh, label: labels[i]!, cx: x + 20 + w / 2, cy: y + 20 + hh / 2,
}));

const night = tone === 'night';
const bg = night ? 'var(--color-night)' : 'var(--color-sand)';
const wall = night ? 'rgba(247,243,236,0.78)' : 'rgba(18,29,43,0.78)';
const thin = night ? 'rgba(247,243,236,0.22)' : 'rgba(18,29,43,0.18)';
const text = night ? 'rgba(247,243,236,0.62)' : 'rgba(18,29,43,0.6)';
const gold = 'var(--color-gold)';

const circuitPath = rects
  .slice(0, Math.min(5, rects.length))
  .map((r, i) => `${i ? 'L' : 'M'}${r.cx.toFixed(0)} ${(r.cy + 14).toFixed(0)}`)
  .join(' ');
const id = `g${h.toString(36)}`;
---

<svg class={cls} viewBox="0 0 420 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })}>
  <defs>
    <pattern id={`${id}-grid`} width="10" height="10" patternUnits="userSpaceOnUse">
      <path d="M10 0H0V10" fill="none" stroke={thin} stroke-width="0.3" opacity="0.6" />
    </pattern>
    <linearGradient id={`${id}-fade`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={gold} stop-opacity="0.12" />
      <stop offset="1" stop-color={gold} stop-opacity="0" />
    </linearGradient>
  </defs>
  <rect width="420" height="300" fill={bg} />
  <rect width="420" height="300" fill={`url(#${id}-grid)`} />
  <rect x="20" y="20" width="380" height="220" fill={`url(#${id}-fade)`} />

  {rects.map((r) => (
    <g>
      <rect x={r.x} y={r.y} width={r.w} height={r.h} fill="none" stroke={wall} stroke-width="1" />
      {detail === 'full' && (
        <>
          <path d={`M${r.x + 8} ${r.y + r.h} a14 14 0 0 1 14 -14`} fill="none" stroke={thin} stroke-width="0.8" />
          <line x1={r.x + 8} y1={r.y + r.h} x2={r.x + 8} y2={r.y + r.h - 14} stroke={wall} stroke-width="0.8" />
        </>
      )}
      <text x={r.cx} y={r.cy} text-anchor="middle" font-family="Manrope Variable, Manrope, sans-serif" font-size="7.2" letter-spacing="1.4" fill={text}>
        {r.label.toUpperCase()}
      </text>
    </g>
  ))}

  <rect x="20" y="20" width="380" height="220" fill="none" stroke={wall} stroke-width="3" />

  {circuit && (
    <path d={circuitPath} fill="none" stroke={gold} stroke-width="1.1" stroke-dasharray="3 4" stroke-linecap="round" />
  )}
  {circuit && rects.slice(0, 5).map((r) => <circle cx={r.cx} cy={r.cy + 14} r="2.2" fill={gold} />)}

  {detail === 'full' && (
    <g stroke={thin} stroke-width="0.6" fill="none">
      <line x1="20" y1="258" x2="400" y2="258" />
      <line x1="20" y1="254" x2="20" y2="262" />
      <line x1="400" y1="254" x2="400" y2="262" />
      <line x1="410" y1="20" x2="410" y2="240" />
      <line x1="406" y1="20" x2="414" y2="20" />
      <line x1="406" y1="240" x2="414" y2="240" />
    </g>
  )}
  {detail === 'full' && (
    <g transform="translate(370 276)" fill="none" stroke={gold} stroke-width="0.8">
      <circle r="9" />
      <path d="M0 -12 L3 0 L0 12 L-3 0Z" fill={gold} fill-opacity="0.25" />
    </g>
  )}
  {detail === 'full' && (
    <text x="20" y="280" font-family="Manrope Variable, Manrope, sans-serif" font-size="6.5" letter-spacing="2" fill={text}>
      PLAN SCHÉMATIQUE · ILLUSTRATION
    </text>
  )}
</svg>

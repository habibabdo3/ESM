---
/** Processus ESM en 4 étapes, horizontal sur desktop, vertical sur mobile. */
interface Props { tone?: 'light' | 'night' }
const { tone = 'light' } = Astro.props;
const steps = [
  { n: '01', t: 'Découvrir', d: 'Nous comprenons votre pratique, votre local et vos contraintes.' },
  { n: '02', t: 'Concevoir', d: 'Nous concevons le plan, les réseaux et le budget par lot.' },
  { n: '03', t: 'Construire', d: 'Nous coordonnons les travaux et l’installation des équipements.' },
  { n: '04', t: 'Livrer', d: 'Nous réceptionnons et préparons votre structure à ouvrir.' },
];
const night = tone === 'night';
---
<div class="relative">
  <span aria-hidden="true" class:list={['absolute left-0 right-0 top-0 hidden h-px md:block', night ? 'bg-white/15' : 'bg-[var(--color-line)]']}></span>
<ol class="grid gap-10 md:grid-cols-4 md:gap-8">
  {steps.map((s, i) => (
    <li class="relative md:pt-7" data-reveal style={`--i:${i}`}>
      <span aria-hidden="true" class:list={['absolute left-0 top-[-1px] hidden h-[3px] w-10 md:block', night ? 'bg-[var(--color-gold)]' : 'bg-[var(--color-teal)]']}></span>
      <span class:list={['font-[family-name:var(--font-display)] text-[0.95rem] font-bold', night ? 'text-[var(--color-gold)]' : 'text-[var(--color-teal-ink)]']}>{s.n}</span>
      <h3 class:list={['mt-5 text-[1.5rem]', night ? 'text-white' : 'text-[var(--color-navy)]']}>{s.t}</h3>
      <p class:list={['mt-2 max-w-xs text-[0.98rem] leading-relaxed', night ? 'text-white/75' : 'text-[var(--color-muted)]']}>{s.d}</p>
    </li>
  ))}
</ol>
</div>

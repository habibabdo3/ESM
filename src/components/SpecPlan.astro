---
/**
 * Les spécialités dessinées comme le plan d'un centre médical : chaque pièce est une spécialité.
 * Clic sur une pièce : un panneau (dialog natif) s'ouvre sur l'accueil avec l'essentiel de la spécialité — une « page
 * virtuelle » : l'URL affichée devient celle de la vraie page (/specialites/…/), qui reste générée et indexée pour le
 * SEO ; « Retour » ferme le panneau. Sans JS, ou avec Ctrl/Cmd/clic milieu, le lien ouvre la vraie page.
 * Desktop : un cartouche sous le plan affiche la contrainte principale de la pièce survolée.
 */
import { specialitePath, servicePath } from '@/lib/content';

export interface SpecPlanItem {
  id: string;
  short: string;
  h1: string;
  description: string;
  contraintes: string[];
  offre: string[];
  aValider: string[];
  services: { id: string; label: string }[];
}
interface Props { items: SpecPlanItem[] }
const { items } = Astro.props;
// Emprise de chaque pièce sur une trame de 12 colonnes (desktop) : [colonnes, rangées]
const spans: [number, number][] = [
  [4, 2], [3, 2], [5, 2],
  [3, 1], [3, 1], [3, 1], [3, 1],
  [5, 2], [4, 2], [3, 2],
  [3, 1], [4, 1], [3, 1], [2, 1],
];
const data = items.map((s) => ({
  ...s,
  href: specialitePath(s.id),
  services: s.services.map((x) => ({ href: servicePath(x.id), label: x.label })),
}));
---
<div class="plan" data-spec-plan-board>
  <ol class="plan-grid" aria-label="Spécialités médicales">
    {items.map((s, i) => {
      const [c, r] = spans[i] ?? [3, 1];
      return (
        <li class:list={['plan-room', i === 0 && 'is-active']} style={`--c:${c};--r:${r};--i:${i % 7}`} data-room={i} data-reveal>
          <a href={specialitePath(s.id)} class="plan-link" data-room-link={i}>
            <span class="plan-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="plan-name">{s.short}</span>
            <span class="plan-door" aria-hidden="true"></span>
            <span class="plan-go" aria-hidden="true">→</span>
          </a>
        </li>
      );
    })}
  </ol>
  <div class="plan-cartouche" aria-hidden="true">
    <span class="plan-cartouche-label">Pièce</span>
    <span class="plan-cartouche-n" data-cartouche-n>01</span>
    <span class="plan-cartouche-name" data-cartouche-name>{items[0]?.short}</span>
    <span class="plan-cartouche-text" data-cartouche-text>{items[0]?.contraintes[0]}</span>
    <span class="plan-cartouche-cta">Ouvrir la pièce →</span>
  </div>

  <dialog class="drawer" data-drawer aria-labelledby="drawer-title">
    <div class="drawer-panel">
      <header class="drawer-head">
        <p class="drawer-kicker">Spécialité <span data-d="n"></span> / {String(items.length).padStart(2, '0')}</p>
        <button type="button" class="drawer-close" data-drawer-close aria-label="Fermer">
          <span aria-hidden="true">×</span>
        </button>
        <h2 id="drawer-title" class="drawer-title" data-d="short"></h2>
        <p class="drawer-h1" data-d="h1"></p>
      </header>
      <div class="drawer-body">
        <p class="drawer-lede" data-d="description"></p>
        <section class="drawer-sec">
          <h3>Contraintes d’aménagement</h3>
          <ul class="drawer-list" data-d="contraintes"></ul>
        </section>
        <section class="drawer-sec">
          <h3>Notre offre</h3>
          <ol class="drawer-offre" data-d="offre"></ol>
        </section>
        <section class="drawer-sec">
          <h3>Autorisations et points à valider</h3>
          <ul class="drawer-list drawer-list--diamond" data-d="aValider"></ul>
        </section>
        <section class="drawer-sec">
          <h3>Services liés</h3>
          <ul class="drawer-links" data-d="services"></ul>
        </section>
      </div>
      <footer class="drawer-foot">
        <a class="btn btn-primary" data-d="cta" href="/contact/">Démarrer ce projet <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link-more" data-d="href" href="/specialites/">Page complète <span>→</span></a>
      </footer>
    </div>
  </dialog>
  <script type="application/json" data-spec-data set:html={JSON.stringify(data)} />
</div>

<script>
  type Item = {
    id: string; short: string; h1: string; description: string; href: string;
    contraintes: string[]; offre: string[]; aValider: string[]; services: { href: string; label: string }[];
  };
  document.querySelectorAll<HTMLElement>('[data-spec-plan-board]').forEach((board) => {
    const rooms = [...board.querySelectorAll<HTMLElement>('[data-room]')];
    const items: Item[] = JSON.parse(board.querySelector('[data-spec-data]')?.textContent ?? '[]');
    const dialog = board.querySelector<HTMLDialogElement>('[data-drawer]');
    const q = (k: string) => dialog?.querySelector<HTMLElement>(`[data-d="${k}"]`);
    const cart = {
      n: board.querySelector<HTMLElement>('[data-cartouche-n]'),
      name: board.querySelector<HTMLElement>('[data-cartouche-name]'),
      text: board.querySelector<HTMLElement>('[data-cartouche-text]'),
    };
    const pad = (i: number) => String(i + 1).padStart(2, '0');
    const activate = (i: number) => {
      rooms.forEach((r, k) => r.classList.toggle('is-active', k === i));
      const d = items[i];
      if (!d) return;
      if (cart.n) cart.n.textContent = pad(i);
      if (cart.name) cart.name.textContent = d.short;
      if (cart.text) cart.text.textContent = d.contraintes[0] ?? '';
    };
    const fill = (el: HTMLElement | null | undefined, list: string[]) => {
      if (!el) return;
      el.replaceChildren(...list.map((t) => Object.assign(document.createElement('li'), { textContent: t })));
    };

    const homeTitle = document.title;
    const homeUrl = location.pathname + location.search;
    let pushed = false;
    const open = (i: number) => {
      const d = items[i];
      if (!dialog || !d) return;
      q('n')!.textContent = pad(i);
      q('short')!.textContent = d.short;
      q('h1')!.textContent = d.h1;
      q('description')!.textContent = d.description;
      fill(q('contraintes'), d.contraintes);
      fill(q('offre'), d.offre);
      fill(q('aValider'), d.aValider);
      const links = q('services');
      links?.replaceChildren(...d.services.map((s) => {
        const li = document.createElement('li');
        const a = Object.assign(document.createElement('a'), { href: s.href, textContent: s.label });
        li.append(a);
        return li;
      }));
      (q('cta') as HTMLAnchorElement).href = `/contact/?specialite=${d.id}`;
      (q('href') as HTMLAnchorElement).href = d.href;
      dialog.querySelector('.drawer-body')?.scrollTo(0, 0);
      if (!dialog.open) dialog.showModal();
      document.documentElement.classList.add('drawer-open');
      // Page virtuelle : l'adresse devient celle de la vraie page (partageable, indexée)
      const title = `${d.short} — Euro Space Medical`;
      if (pushed) history.replaceState({ spec: i }, '', d.href);
      else history.pushState({ spec: i }, '', d.href);
      pushed = true;
      document.title = title;
    };
    const restore = () => {
      document.documentElement.classList.remove('drawer-open');
      document.title = homeTitle;
    };

    rooms.forEach((r, i) => {
      r.addEventListener('pointerenter', () => activate(i));
      r.addEventListener('focusin', () => activate(i));
      r.querySelector('a')?.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0 || !dialog?.showModal) return;
        e.preventDefault();
        activate(i);
        open(i);
      });
    });
    // Fermer = revenir à l'accueil dans l'historique
    const close = () => {
      if (pushed) history.back();
      else dialog?.close();
    };
    dialog?.querySelector('[data-drawer-close]')?.addEventListener('click', close);
    dialog?.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    dialog?.addEventListener('click', (e) => e.target === dialog && close());
    dialog?.addEventListener('close', restore);
    window.addEventListener('popstate', (e) => {
      const i = (e.state as { spec?: number } | null)?.spec;
      if (typeof i === 'number') open(i);
      else {
        pushed = false;
        if (dialog?.open) dialog.close();
        if (location.pathname + location.search !== homeUrl) history.replaceState(null, '', homeUrl);
      }
    });
  });
</script>

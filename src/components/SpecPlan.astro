---
/**
 * Les spécialités dessinées comme le plan d'un centre médical : chaque pièce est une spécialité (lien vers sa page).
 * Murs navy, débattement de porte par pièce, pièce active teintée ; un cartouche sous le plan (desktop) affiche la
 * contrainte principale de la pièce survolée ou ciblée au clavier. Mobile : plan sur deux colonnes, sans cartouche.
 */
import { specialitePath } from '@/lib/content';

interface Props { items: { id: string; short: string; contrainte: string }[] }
const { items } = Astro.props;
// Emprise de chaque pièce sur une trame de 12 colonnes (desktop) : [colonnes, rangées]
const spans: [number, number][] = [
  [4, 2], [3, 2], [5, 2],
  [3, 1], [3, 1], [3, 1], [3, 1],
  [5, 2], [4, 2], [3, 2],
  [3, 1], [4, 1], [3, 1], [2, 1],
];
---
<div class="plan" data-spec-plan-board>
  <ol class="plan-grid" aria-label="Spécialités médicales">
    {items.map((s, i) => {
      const [c, r] = spans[i] ?? [3, 1];
      return (
        <li class:list={['plan-room', i === 0 && 'is-active']} style={`--c:${c};--r:${r};--i:${i % 7}`} data-room={i} data-reveal>
          <a href={specialitePath(s.id)} class="plan-link">
            <span class="plan-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="plan-name">{s.short}</span>
            <span class="plan-door" aria-hidden="true"></span>
            <span class="plan-go" aria-hidden="true">→</span>
          </a>
        </li>
      );
    })}
  </ol>
  <div class="plan-cartouche" aria-hidden="true">
    <span class="plan-cartouche-label">Pièce</span>
    <span class="plan-cartouche-n" data-cartouche-n>01</span>
    <span class="plan-cartouche-name" data-cartouche-name>{items[0]?.short}</span>
    <span class="plan-cartouche-text" data-cartouche-text>{items[0]?.contrainte}</span>
    <span class="plan-cartouche-cta">Voir le plan type →</span>
  </div>
  <script type="application/json" data-cartouche-data set:html={JSON.stringify(items.map((s) => [s.short, s.contrainte]))} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-spec-plan-board]').forEach((board) => {
    const rooms = [...board.querySelectorAll<HTMLElement>('[data-room]')];
    const data: [string, string][] = JSON.parse(board.querySelector('[data-cartouche-data]')?.textContent ?? '[]');
    const n = board.querySelector<HTMLElement>('[data-cartouche-n]');
    const name = board.querySelector<HTMLElement>('[data-cartouche-name]');
    const text = board.querySelector<HTMLElement>('[data-cartouche-text]');
    const activate = (i: number) => {
      rooms.forEach((r, k) => r.classList.toggle('is-active', k === i));
      const d = data[i];
      if (!d) return;
      if (n) n.textContent = String(i + 1).padStart(2, '0');
      if (name) name.textContent = d[0];
      if (text) text.textContent = d[1];
    };
    rooms.forEach((r, i) => {
      r.addEventListener('pointerenter', () => activate(i));
      r.addEventListener('focusin', () => activate(i));
    });
  });
</script>

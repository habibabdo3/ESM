---
interface Props { items: { name: string; path: string }[]; tone?: 'light' | 'dark' }
const { items, tone = 'dark' } = Astro.props;
---
<nav aria-label="Fil d’Ariane" class:list={['text-[0.82rem] font-medium', tone === 'light' ? 'text-white/75' : 'text-[var(--color-muted)]']}>
  <ol class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
    {items.map((it, i) => (
      <li class="flex items-center gap-2.5">
        {i > 0 && <span aria-hidden="true" class="text-[var(--color-slate)]">/</span>}
        {i < items.length - 1 ? <a href={it.path} class="link-lux hover:text-[var(--color-navy)]">{it.name}</a> : <span aria-current="page" class="text-[var(--color-ink)]">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>

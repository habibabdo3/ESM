---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import { partners, etapesProjetFinance, piecesDossier } from '@/data/financement';
import Faq from '@/components/Faq.astro';
import { bankClaimsApproved, BANK_DISCLAIMER } from '@/config/site';
import { breadcrumb, faqPage } from '@/lib/schema';
import { pad } from '@/lib/content';

interface Props { id: (typeof partners)[number]['id'] }
const p = partners.find((x) => x.id === Astro.props.id)!;
const other = partners.find((x) => x.id !== p.id)!;
const base = Astro.site!;
const faq = [
  { q: `Faut-il être déjà client de ${p.short} ?`, a: 'Non. Le dossier peut être ouvert à l’occasion du projet. La banque vous indiquera les démarches d’ouverture de compte nécessaires.' },
  { q: 'Que prépare Euro Space Medical pour le dossier ?', a: 'Le devis détaillé par lot, les factures pro forma des équipements, les plans d’aménagement, le planning et, si besoin, le business plan. Vous fournissez les pièces personnelles et professionnelles.' },
  { q: 'Les fonds peuvent-ils être débloqués selon l’avancement des travaux ?', a: 'C’est l’organisation que nous mettons en place avec la banque lorsque le produit le permet : démarrage après accord, puis déblocage par tranches sur justificatifs d’avancement.' },
  { q: 'Pouvez-vous annoncer un taux ou un délai de réponse ?', a: 'Les conditions (taux, marge, durée, apport) dépendent de votre profil et du produit retenu. Elles vous sont communiquées par la banque lors de l’instruction du dossier.' },
];
const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Financement', path: '/financement/' }, { name: p.short, path: p.path }];
---
<BaseLayout title={p.title} description={p.description} noindex={!bankClaimsApproved} jsonld={[breadcrumb(base, crumbs), faqPage(faq)]} context={`Financement ${p.short}`}>
  <PageHero eyebrow="Financement" h1={p.h1} intro={p.accroche} crumbs={crumbs} variant="medecine-generale-cabinets-de-groupe" ctaLabel="Simuler le financement de mon projet">
    <p class="mt-6 text-[0.85rem] italic text-[var(--color-ivory)]/65">{BANK_DISCLAIMER}</p>
  </PageHero>

  <section class="py-20 lg:py-28">
    <div class="container-lux grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow text-[var(--color-gold-deep)]">Solutions</p>
        <h2 class="mt-6">Les produits proposés</h2>
        <p class="mt-6 text-[var(--color-stone-ink)]">{p.contexte}</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-3 lg:col-span-8">
        {p.produits.map((x, i) => (
          <div class="border border-[var(--color-line)] bg-white/40 p-8" data-reveal style={`--i:${i}`}>
            <span class="gold-rule"></span>
            <h3 class="mt-6 text-[1.5rem]">{x.t}</h3>
            <p class="mt-4 text-[0.95rem] text-[var(--color-stone-ink)]">{x.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-20 lg:pb-28">
    <div class="container-lux grid gap-16 lg:grid-cols-2">
      <div data-reveal>
        <p class="eyebrow text-[var(--color-gold-deep)]">Pour qui</p>
        <h2 class="mt-6 text-[2.2rem]">Les profils accompagnés</h2>
        <ul class="mt-8 space-y-4">
          {p.pourQui.map((x) => <li class="flex gap-4 border-b border-[var(--color-line)] pb-4"><span class="mt-3 block h-px w-6 shrink-0 bg-[var(--color-gold-deep)]"></span>{x}</li>)}
        </ul>
      </div>
      <div data-reveal style="--i:1">
        <p class="eyebrow text-[var(--color-gold-deep)]">Dossier</p>
        <h2 class="mt-6 text-[2.2rem]">Pièces généralement demandées</h2>
        <ul class="mt-8 space-y-4">
          {piecesDossier.map((x) => <li class="flex gap-4 border-b border-[var(--color-line)] pb-4"><span class="text-[var(--color-gold-deep)]" aria-hidden="true">◆</span>{x}</li>)}
        </ul>
        <p class="mt-4 text-[0.85rem] text-[var(--color-stone-ink)]">La liste exacte est communiquée par la banque pour chaque dossier.</p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-sand)] py-20 lg:py-28">
    <div class="container-lux">
      <h2 class="max-w-3xl">Notre accompagnement « Projet financé »</h2>
      <ol class="mt-12 grid gap-px overflow-hidden bg-[var(--color-line)] md:grid-cols-5">
        {etapesProjetFinance.map((e, i) => (
          <li class="bg-[var(--color-sand)] p-6" data-reveal style={`--i:${i}`}><span class="num text-4xl">{pad(i + 1)}</span><h3 class="mt-4 text-[1.35rem]">{e.t}</h3><p class="mt-3 text-[0.9rem] text-[var(--color-stone-ink)]">{e.p}</p></li>
        ))}
      </ol>
      <p class="mt-8 text-[0.85rem] italic text-[var(--color-stone-ink)]">{BANK_DISCLAIMER} Aucun taux d’acceptation n’est garanti. Les conditions des dispositifs publics sont vérifiées à la date du dossier.</p>
    </div>
  </section>

  <Faq items={faq} />

  <section class="py-20 lg:py-28">
    <div class="container-lux">
      <RelatedLinks title="Voir aussi" links={[
        { href: other.path, label: other.h1, meta: 'Financement' },
        { href: '/financement/', label: 'Toutes nos solutions de financement', meta: 'Financement' },
        { href: '/services/financement-lancement-suivi-projet-medical/', label: 'Financement, lancement et suivi', meta: 'Service 10' },
      ]} />
    </div>
  </section>

  <CtaBand context={`Financement ${p.short}`} title="Simuler le financement de mon projet" cta="Demander une simulation" />
</BaseLayout>

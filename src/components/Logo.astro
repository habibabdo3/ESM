---
/**
 * Logo Euro Space Medical (choisi le 2026-11-08) : monogramme ESM en dégradé navy → teal, toiture or au-dessus,
 * arc or en dessous ; nom sur deux lignes justifiées et signature or.
 * Géométrie vectorielle unique : src/data/logo.json (générée par `npm run brand`, partagée avec public/brand/).
 * layout : horizontal | vertical | symbol · tone : color | navy | white | mono · size : hauteur du symbole en px.
 */
import logo from '@/data/logo.json';

interface Props {
  layout?: 'horizontal' | 'vertical' | 'symbol';
  tone?: 'color' | 'white' | 'navy' | 'mono';
  tagline?: boolean;
  class?: string;
  size?: number;
}
const { layout = 'horizontal', tone = 'color', class: cls = '', size = 40 } = Astro.props;
// La signature n'est lisible qu'à partir d'environ 70 px de haut : en dessous, nom seul.
const tagline = (Astro.props.tagline ?? true) && size >= 70;

const palette = {
  color: { a: '#142C43', b: '#168C91', gold: '#C6A66B', word: '#142C43', tag: '#9C7B42' },
  navy: { a: '#142C43', b: '#142C43', gold: '#142C43', word: '#142C43', tag: '#142C43' },
  white: { a: '#FFFFFF', b: '#FFFFFF', gold: '#C6A66B', word: '#FFFFFF', tag: '#C6A66B' },
  mono: { a: 'currentColor', b: 'currentColor', gold: 'currentColor', word: 'currentColor', tag: 'currentColor' },
}[tone];

const id = `esm-${Math.random().toString(36).slice(2, 8)}`;
const symbolW = Math.round((size * logo.width) / logo.height);
const wm = logo.wordmark;
const wmH = tagline ? wm.height : wm.nameOnly.height;
const wordHeight = layout === 'vertical' ? size * 0.62 : size * (tagline ? 0.86 : 0.62);
const wordWidth = Math.round((wordHeight * wm.width) / wmH);
---

<span
  role="img"
  aria-label="Euro Space Medical"
  class:list={['inline-flex shrink-0', layout === 'vertical' ? 'flex-col items-center gap-3' : 'items-center gap-3', cls]}
>
  <svg width={symbolW} height={size} viewBox={logo.viewBox} aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={id} x1="0" x2="1">
        <stop offset="0" stop-color={palette.a} />
        <stop offset="0.5" stop-color={palette.b} />
        <stop offset="1" stop-color={palette.a} />
      </linearGradient>
    </defs>
    <g transform={logo.lettersTransform}><path d={logo.letters} fill={`url(#${id})`} /></g>
    <path d={logo.roof} fill="none" stroke={palette.gold} stroke-width="3.2" />
    <path d={logo.chimney} fill="none" stroke={palette.gold} stroke-width="3.2" />
    <path d={logo.swoosh} fill={palette.gold} />
  </svg>
  {layout !== 'symbol' && (
    <svg width={wordWidth} height={Math.round(wordHeight)} viewBox={`0 0 ${wm.width} ${wmH}`} aria-hidden="true" focusable="false" class="wordmark">
      <path d={wm.name} fill={palette.word} />
      {tagline && <path d={wm.tag} fill={palette.tag} />}
    </svg>
  )}
</span>

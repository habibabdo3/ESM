---
/** Visuel d'une section ou d'une page : photo optimisée, ou dessin technique original (PlanArt) dans le même cadre. */
import Photo from './Photo.astro';
import PlanArt from './PlanArt.astro';
import type { Visual } from '@/lib/photos';

interface Props {
  visual: Visual;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
}
const { visual, sizes, widths, eager = false, class: cls = 'h-full w-full object-cover' } = Astro.props;
---
{'photo' in visual ? (
  <Photo name={visual.photo} sizes={sizes} widths={widths} eager={eager} class={cls} />
) : (
  <div class="relative h-full w-full bg-[var(--color-mist)]">
    <PlanArt variant={visual.drawing} tone="light" detail="full" class="h-full w-full" label={`Illustration : ${visual.label}`} />
    <span class="absolute left-4 top-4 bg-white/90 px-2.5 py-1 text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-[var(--color-navy)]">{visual.label}</span>
  </div>
)}

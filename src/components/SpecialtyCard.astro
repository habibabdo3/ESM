---
import PlanArt from './PlanArt.astro';
import { specialitePath } from '@/lib/content';
interface Props { id: string; short: string; contrainte?: string; i?: number }
const { id, short, contrainte, i = 0 } = Astro.props;
---
<article class="card-lux group relative" data-reveal style={`--i:${i % 3}`}>
  <div class="card-media relative aspect-[4/3] overflow-hidden rounded-[var(--radius-photo)] bg-[var(--color-mist)]">
    <PlanArt variant={id} tone="light" class="h-full w-full" detail="simple" label={`Illustration : plan schématique — ${short}`} />
  </div>
  <h3 class="mt-5 text-[1.375rem] text-[var(--color-navy)]">
    <a href={specialitePath(id)} class="no-underline after:absolute after:inset-0">{short}</a>
  </h3>
  {contrainte && <p class="mt-2 line-clamp-2 text-[0.95rem] leading-relaxed text-[var(--color-muted)]">{contrainte}</p>}
  <span class="link-more mt-4" aria-hidden="true">Découvrir <span>→</span></span>
</article>

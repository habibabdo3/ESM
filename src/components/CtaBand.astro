---
import { whatsappLink } from '@/config/site';
interface Props { title?: string; text?: string; cta?: string; context?: string }
const {
  title = 'Parlons de votre projet',
  text = 'Une visite technique, un programme, un budget par lot : nous vous aidons à décider en connaissance de cause.',
  cta = 'Demander un devis',
  context = 'site',
} = Astro.props;
const wa = whatsappLink(`Bonjour, je souhaite parler de mon projet (${context}).`);
---
<section class="relative overflow-hidden bg-[var(--color-night)] text-[var(--color-ivory)]">
  <div class="container-lux relative py-20 lg:py-28">
    <div class="absolute right-0 top-0 h-full w-1/2 opacity-[0.07]" aria-hidden="true">
      <svg viewBox="0 0 200 200" class="h-full w-full"><circle cx="160" cy="40" r="140" fill="none" stroke="var(--color-gold)" stroke-width="0.6" /><circle cx="160" cy="40" r="100" fill="none" stroke="var(--color-gold)" stroke-width="0.6" /><circle cx="160" cy="40" r="60" fill="none" stroke="var(--color-gold)" stroke-width="0.6" /></svg>
    </div>
    <div class="relative max-w-3xl" data-reveal>
      <span class="gold-rule"></span>
      <h2 class="mt-8">{title}</h2>
      <p class="mt-6 max-w-2xl text-lg text-[var(--color-ivory)]/75">{text}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/contact/" class="btn btn-gold">{cta} <span class="arrow" aria-hidden="true">→</span></a>
        {wa && <a href={wa} target="_blank" rel="noopener" class="btn btn-ghost-light">WhatsApp</a>}
      </div>
    </div>
  </div>
</section>

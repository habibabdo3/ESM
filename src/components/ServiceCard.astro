---
import { servicePath, pad } from '@/lib/content';
interface Props { id: string; order: number; short: string; h1: string; intro: string; description?: string; termes?: string[]; i?: number; tone?: 'light' | 'night' }
const { id, order, short, intro, termes = [], i = 0 } = Astro.props;
const excerpt = Astro.props.description ?? intro.split('. ')[0] + '.';
---
<article class="card-lux group relative flex h-full flex-col border-t border-[var(--color-line)] pt-7" data-reveal style={`--i:${i % 3}`}>
  <span class="num text-[0.95rem]">{pad(order)}</span>
  <h3 class="mt-3 text-[1.375rem] text-[var(--color-navy)]">
    <a href={servicePath(id)} class="no-underline after:absolute after:inset-0">{short}</a>
  </h3>
  <p class="mt-3 flex-1 text-[0.98rem] leading-relaxed text-[var(--color-muted)]">{excerpt}</p>
  {termes.length > 0 && (
    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Termes techniques">
      {termes.map((t) => <li class="bg-[var(--color-mist)] px-2.5 py-1 text-[0.78rem] font-medium text-[var(--color-ink)]">{t}</li>)}
    </ul>
  )}
  <span class="link-more mt-6" aria-hidden="true">Découvrir <span>→</span></span>
</article>

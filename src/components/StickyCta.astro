---
import Icon from './Icon.astro';
import { whatsappLink } from '@/config/site';

interface Props { context: string }
const { context } = Astro.props;
const wa = whatsappLink(`Bonjour Euro Space Medical, je consulte la page « ${context} » et je souhaite parler de mon projet.`);
const waHref = wa ?? '/contact/';
---

<!-- Mobile : barre fixe en bas de l'écran sur toutes les pages -->
<div class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-2 border-t border-[var(--color-navy-3)] bg-[var(--color-navy)] md:hidden" style="padding-bottom: env(safe-area-inset-bottom)">
  <a href={waHref} {...(wa ? { target: '_blank', rel: 'noopener' } : {})} class="flex h-14 items-center justify-center gap-2 text-[0.78rem] font-semibold uppercase tracking-[0.08em] text-white no-underline" data-track="whatsapp">
    <Icon name="whatsapp" size={20} class="text-white" /> WhatsApp
  </a>
  <a href="/contact/" class="flex h-14 items-center justify-center gap-2 bg-white text-[0.78rem] font-bold uppercase tracking-[0.08em] text-[var(--color-navy)] no-underline">
    Demander un devis
  </a>
</div>

<!-- Desktop : bouton WhatsApp flottant -->
<a href={waHref} {...(wa ? { target: '_blank', rel: 'noopener' } : {})} aria-label="Nous écrire sur WhatsApp" class="fixed bottom-8 right-8 z-30 hidden h-14 w-14 items-center justify-center rounded-full bg-[var(--color-navy)] text-white shadow-lg transition-colors duration-200 hover:bg-[var(--color-teal-ink)] md:inline-flex" data-track="whatsapp">
  <Icon name="whatsapp" size={24} />
</a>

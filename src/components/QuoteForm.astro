---
import { getSpecialites } from '@/lib/content';
import { bankClaimsApproved, BANK_DISCLAIMER, whatsappLink } from '@/config/site';

const specialites = await getSpecialites();
const financement = bankClaimsApproved
  ? ['Al Barid Bank', 'Bank Al Yousr', 'Je ne sais pas', 'Non']
  : ['Crédit professionnel ou Intelaka', 'Financement participatif (Mourabaha, Ijara)', 'Je ne sais pas', 'Non'];
const wa = whatsappLink('Bonjour, je souhaite un devis pour mon projet médical.');
const field = 'mt-2 block w-full border border-[var(--color-line)] bg-white px-4 py-3 text-[1rem] text-[var(--color-ink)] transition focus:border-[var(--color-gold-deep)] focus:outline-none focus-visible:outline-2 focus-visible:outline-[var(--color-gold)]';
const lbl = 'text-[0.78rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-ink)]';
---

<form id="quote-form" class="grid gap-6 sm:grid-cols-2" method="post" action="/api/devis" novalidate>
  <div>
    <label for="f-nom" class={lbl}>Nom et prénom *</label>
    <input id="f-nom" name="nom" autocomplete="name" required class={field} />
  </div>
  <div>
    <label for="f-tel" class={lbl}>Téléphone *</label>
    <input id="f-tel" name="telephone" type="tel" autocomplete="tel" required inputmode="tel" class={field} />
  </div>
  <div>
    <label for="f-email" class={lbl}>E-mail *</label>
    <input id="f-email" name="email" type="email" autocomplete="email" required class={field} />
  </div>
  <div>
    <label for="f-ville" class={lbl}>Ville *</label>
    <input id="f-ville" name="ville" autocomplete="address-level2" required class={field} />
  </div>
  <div>
    <label for="f-structure" class={lbl}>Type de structure *</label>
    <select id="f-structure" name="structure" required class={field}>
      <option value="">Choisir…</option>
      {specialites.map((s) => <option value={s.id}>{s.data.short}</option>)}
      <option value="autre">Autre</option>
    </select>
  </div>
  <div>
    <label for="f-nature" class={lbl}>Nature du projet *</label>
    <select id="f-nature" name="nature" required class={field}>
      <option value="">Choisir…</option>
      <option>Création</option>
      <option>Rénovation</option>
      <option>Extension</option>
    </select>
  </div>
  <div>
    <label for="f-surface" class={lbl}>Surface approximative (m²)</label>
    <input id="f-surface" name="surface" type="number" min="5" max="100000" inputmode="numeric" class={field} />
  </div>
  <div>
    <label for="f-calendrier" class={lbl}>Calendrier souhaité</label>
    <select id="f-calendrier" name="calendrier" class={field}>
      <option value="">Choisir…</option>
      <option>Dans les 3 mois</option>
      <option>Dans 3 à 6 mois</option>
      <option>Dans 6 à 12 mois</option>
      <option>Plus tard / à définir</option>
    </select>
  </div>
  <fieldset class="sm:col-span-2">
    <legend class={lbl}>Souhaitez-vous un financement ?</legend>
    <div class="mt-3 flex flex-wrap gap-x-6 gap-y-3">
      {financement.map((f) => (
        <label class="inline-flex items-center gap-2 text-[0.95rem]">
          <input type="radio" name="financement" value={f} class="h-4 w-4 accent-[var(--color-gold-deep)]" /> {f}
        </label>
      ))}
    </div>
    <p class="mt-2 text-[0.8rem] text-[var(--color-stone-ink)]">{BANK_DISCLAIMER}</p>
  </fieldset>
  <div class="sm:col-span-2">
    <label for="f-message" class={lbl}>Votre projet</label>
    <textarea id="f-message" name="message" rows="5" class={field} placeholder="Local, nombre de salles, équipements prévus, contraintes…"></textarea>
  </div>
  <!-- Champ piège anti-spam : invisible pour les humains -->
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label for="f-site">Ne pas remplir</label>
    <input id="f-site" name="site_web" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <div class="sm:col-span-2">
    <label class="flex items-start gap-3 text-[0.88rem] leading-relaxed text-[var(--color-stone-ink)]">
      <input type="checkbox" name="consentement" required class="mt-1 h-4 w-4 shrink-0 accent-[var(--color-gold-deep)]" />
      <span>
        J’accepte que mes données soient utilisées par Euro Space Medical pour traiter ma demande de devis, conformément à la loi 09-08.
        Je peux exercer mes droits d’accès, de rectification, d’opposition et de suppression à tout moment. <a href="/confidentialite/" class="underline underline-offset-2">Politique de confidentialité</a> *
      </span>
    </label>
  </div>
  <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
    <button type="submit" class="btn btn-gold">Envoyer ma demande <span class="arrow" aria-hidden="true">→</span></button>
    <p class="text-[0.8rem] text-[var(--color-stone-ink)]">* Champs obligatoires</p>
  </div>
  <p id="form-status" role="status" aria-live="polite" class="text-[0.95rem] sm:col-span-2" data-wa={wa ?? ''}></p>
</form>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const params = new URLSearchParams(location.search);
  const pre = params.get('specialite');
  if (form && pre) {
    const sel = form.querySelector<HTMLSelectElement>('#f-structure');
    if (sel && [...sel.options].some((o) => o.value === pre)) sel.value = pre;
  }
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
    btn?.setAttribute('disabled', '');
    status.textContent = 'Envoi en cours…';
    try {
      const res = await fetch('/api/devis', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = 'Merci. Votre demande a bien été envoyée : nous revenons vers vous rapidement.';
    } catch {
      const wa = status.dataset.wa;
      status.innerHTML = wa
        ? `L’envoi n’a pas abouti. Vous pouvez nous écrire directement sur <a class="underline" href="${wa}" target="_blank" rel="noopener">WhatsApp</a>.`
        : 'L’envoi n’a pas abouti. Merci de réessayer dans quelques minutes.';
    } finally {
      btn?.removeAttribute('disabled');
    }
  });
</script>

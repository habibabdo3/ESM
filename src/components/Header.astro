---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Accueil', match: (p: string) => p === '/' },
  {
    href: '/expertises/',
    label: 'Expertises',
    match: (p: string) => ['/expertises/', '/services/', '/specialites/', '/renovation-cabinet-clinique/', '/amenagement-cabinet-medical/', '/financement/', '/premiere-installation/'].some((x) => p.startsWith(x)),
  },
  { href: '/realisations/', label: 'Réalisations', match: (p: string) => p.startsWith('/realisations/') },
  { href: '/a-propos/', label: 'À propos', match: (p: string) => p.startsWith('/a-propos/') },
  { href: '/contact/', label: 'Contact', match: (p: string) => p.startsWith('/contact/') },
];
const secondary = [
  { href: '/services/', label: 'Services' },
  { href: '/specialites/', label: 'Spécialités' },
  { href: '/financement/', label: 'Financement' },
  { href: '/zones-intervention/', label: 'Zones d’intervention' },
  { href: '/blog/', label: 'Guides' },
];
---

<header class="site-header sticky top-0 z-40 w-full border-b border-[var(--color-line)] bg-white/95 text-[var(--color-navy)] backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-[var(--color-navy)] focus:px-4 focus:py-2 focus:text-white">
    Aller au contenu
  </a>
  <div class="container-lux flex h-[4.5rem] items-center justify-between gap-6 lg:h-20">
    <a href="/" class="shrink-0 no-underline" aria-label="Euro Space Medical, accueil">
      <Logo size={42} tagline={true} class="[&_[lang=en]]:hidden sm:[&_[lang=en]]:block" />
    </a>

    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-9 font-[family-name:var(--font-display)] text-[0.95rem] font-semibold">
        {nav.map((n) => {
          const active = n.match(path);
          return (
            <li>
              <a
                href={n.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'relative py-2 no-underline transition-colors duration-200 hover:text-[var(--color-teal-ink)]',
                  "after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:bg-[var(--color-teal)] after:transition-transform after:duration-300 after:content-['']",
                  active ? 'after:scale-x-100' : 'after:scale-x-0 hover:after:scale-x-100',
                ]}
              >
                {n.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/contact/" class="btn btn-primary hidden md:inline-flex">Parler de mon projet</a>
      <button
        type="button"
        class="menu-toggle inline-flex h-12 w-12 items-center justify-center lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Ouvrir le menu"
      >
        <Icon name="menu" size={26} />
      </button>
    </div>
  </div>

  <div id="menu-mobile" class="mobile-menu fixed inset-0 z-50 hidden overflow-y-auto bg-white text-[var(--color-navy)]">
    <div class="container-lux flex h-[4.5rem] items-center justify-between border-b border-[var(--color-line)]">
      <Logo size={36} tagline={false} />
      <button type="button" class="menu-close inline-flex h-12 w-12 items-center justify-center" aria-label="Fermer le menu">
        <Icon name="close" size={26} />
      </button>
    </div>
    <nav aria-label="Navigation mobile" class="container-lux pb-32 pt-6">
      <ul class="divide-y divide-[var(--color-line)] font-[family-name:var(--font-display)] text-[1.6rem] font-semibold">
        {nav.map((n) => (
          <li>
            <a href={n.href} aria-current={n.match(path) ? 'page' : undefined} class:list={['flex items-center justify-between py-4 no-underline', n.match(path) && 'text-[var(--color-teal-ink)]']}>
              {n.label}<span aria-hidden="true" class="text-base text-[var(--color-slate)]">→</span>
            </a>
          </li>
        ))}
      </ul>
      <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-3 text-[0.95rem] text-[var(--color-muted)]">
        {secondary.map((s) => <li><a href={s.href} class="no-underline hover:text-[var(--color-navy)]">{s.label}</a></li>)}
      </ul>
      <a href="/contact/" class="btn btn-primary mt-10 w-full">Parler de mon projet</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('menu-mobile');
  const close = menu?.querySelector<HTMLButtonElement>('.menu-close');
  const setOpen = (open: boolean) => {
    if (!menu || !toggle) return;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? close : toggle)?.focus();
  };
  toggle?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setOpen(false);
  });
</script>

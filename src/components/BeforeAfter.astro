---
/** Comparateur avant/après : souris, doigt et clavier (flèches). Rôle slider + valeurs ARIA. */
interface Props { label?: string }
const { label = 'Comparer avant et après travaux' } = Astro.props;
---
<div class="ba relative aspect-[16/10] select-none overflow-hidden rounded-[var(--radius-photo)] bg-[var(--color-navy)]" style="--pos:50%">
  <div class="absolute inset-0"><slot name="after" /></div>
  <div class="absolute inset-0" style="clip-path: inset(0 calc(100% - var(--pos)) 0 0)"><slot name="before" /></div>
  <span class="caption pointer-events-none absolute left-4 top-4 bg-[var(--color-navy)]/70 px-2 py-1 text-[var(--color-warm)]">Avant</span>
  <span class="caption pointer-events-none absolute right-4 top-4 bg-[var(--color-navy)]/70 px-2 py-1 text-[var(--color-warm)]">Après</span>
  <div
    class="ba-handle absolute inset-y-0 z-10 w-12 -translate-x-1/2 cursor-ew-resize touch-none outline-none"
    style="left: var(--pos)"
    role="slider"
    tabindex="0"
    aria-label={label}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
    aria-valuetext="50 % avant"
  >
    <span class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-[var(--color-warm)]/90"></span>
    <span class="absolute left-1/2 top-1/2 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-[var(--color-gold)] bg-[var(--color-navy)]/80 text-[var(--color-gold)]">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6" /></svg>
    </span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.ba').forEach((root) => {
    const handle = root.querySelector<HTMLElement>('.ba-handle');
    if (!handle) return;
    const set = (v: number) => {
      const p = Math.max(0, Math.min(100, v));
      root.style.setProperty('--pos', `${p}%`);
      handle.setAttribute('aria-valuenow', String(Math.round(p)));
      handle.setAttribute('aria-valuetext', `${Math.round(p)} % avant`);
    };
    const fromEvent = (x: number) => {
      const r = root.getBoundingClientRect();
      set(((x - r.left) / r.width) * 100);
    };
    let drag = false;
    root.addEventListener('pointerdown', (e) => { drag = true; root.setPointerCapture(e.pointerId); fromEvent(e.clientX); });
    root.addEventListener('pointermove', (e) => { if (drag) fromEvent(e.clientX); });
    root.addEventListener('pointerup', () => { drag = false; });
    root.addEventListener('pointercancel', () => { drag = false; });
    handle.addEventListener('keydown', (e) => {
      const now = Number(handle.getAttribute('aria-valuenow'));
      const step = e.shiftKey ? 10 : 2;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') set(now - step);
      else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') set(now + step);
      else if (e.key === 'Home') set(0);
      else if (e.key === 'End') set(100);
      else return;
      e.preventDefault();
    });
  });
</script>

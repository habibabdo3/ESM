# URL publique du site (canonical, sitemap). Sur Vercel, VERCEL_PROJECT_PRODUCTION_URL est utilisée à défaut.
SITE_URL=https://www.eurospacemedical.ma

# Coordonnées affichées (laisser vide = marqueur [À COMPLÉTER] visible)
PUBLIC_PHONE=
PUBLIC_EMAIL=
PUBLIC_WHATSAPP=           # format international sans +, ex. 212600000000
PUBLIC_ADDRESS=
PUBLIC_INSTAGRAM_URL=
PUBLIC_FACEBOOK_URL=

# Mentions bancaires : true uniquement après accord écrit des deux banques
BANK_CLAIMS_APPROVED=false

# Analytique et pixel (chargés seulement après consentement)
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_META_PIXEL_ID=

# Fonction serverless /api/devis (Vercel) — jamais dans le dépôt
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=
